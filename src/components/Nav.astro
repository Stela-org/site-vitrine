---
import { SITE, NAV_LINKS, TARIFS_URL, LOGIN_URL } from "../config/site";
import Logo from "./Logo.astro";
// Navbar sticky sur toutes les pages (via Base). Parcours court et évident
// (Nielsen/Norman) : 4 liens + 1 CTA laiton, plus un lien « Se connecter »
// discret pour le client déjà inscrit (LOT VIT-CONNEXION). Ce dernier est posé
// HORS de `.nav-links` volontairement : les liens de section disparaissent
// derrière le burger en mobile, la porte d'entrée d'un client, non.
// Menu mobile 100 % CSS via une case
// à cocher masquée (accessible et fonctionnel SANS JavaScript, compatible CSP).
// NB : on n'utilise PAS <details> ici (les Chromium récents n'en peignent plus le
// contenu fermé, ce qui rendait les liens desktop invisibles).
---
<header class="nav">
  <div class="container nav-inner">
    <a href="/" class="nav-logo" aria-label={`${SITE.brand}, accueil`}><Logo /></a>
    {/* Version MOBILE du lien de connexion : dans la barre, à côté du burger,
        parce que les liens de section passent derrière lui et que la porte
        d'entrée d'un client ne doit jamais y disparaître. Masquée en desktop. */}
    <a class="nav-login nav-login-mobile" href={LOGIN_URL}>Se connecter</a>
    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="Ouvrir ou fermer le menu" />
    <label for="nav-toggle" class="nav-burger" aria-hidden="true"><span></span></label>
    <nav class="nav-links" aria-label="Navigation principale">
      {NAV_LINKS.map((l) => <a href={l.href}>{l.label}</a>)}
      {/* Version DESKTOP : à sa place conventionnelle, juste avant le CTA,
          séparée des rubriques par un filet vertical. Posé entre le logo et
          les rubriques (première version), il flottait comme un élément
          oublié (constat de Nicolas sur le rendu réel, 07/08). */}
      <a class="nav-login nav-login-desktop" href={LOGIN_URL}>Se connecter</a>
      <a class="btn btn-primary nav-cta" href={TARIFS_URL}>Essai gratuit 7 jours</a>
    </nav>
  </div>
</header>
<style>
  .nav { position: sticky; top: 0; z-index: 50; background: rgba(247, 244, 239, .9);
    backdrop-filter: saturate(150%) blur(8px); border-bottom: 1px solid var(--border); }
  .nav-inner { display: flex; align-items: center; justify-content: space-between; min-height: var(--nav-h); position: relative; }
  /* `margin-right: auto` colle le groupe de droite au bord : avec plusieurs
     enfants, `space-between` seul les écarterait un à un. */
  .nav-logo { margin-right: auto; }
  .nav-logo:hover { text-decoration: none; }

  /* « Se connecter » n'est pas un appel à l'action : c'est un service rendu à
     quelqu'un qui est DÉJÀ client. Un cran sous les liens de section (500 au
     lieu de 600, un peu plus petit), deux crans sous le CTA laiton. En
     desktop il vit DANS le groupe de droite, à sa place conventionnelle :
     juste avant le CTA, séparé des rubriques par un filet vertical (le trait
     fait le travail de distinction que l'espacement seul ne faisait pas). */
  .nav-login { font-weight: 500; font-size: .92rem; color: var(--text-secondary);
    transition: color .15s ease; }
  .nav-login:hover { color: var(--ink); }
  .nav-login-desktop { border-left: 1px solid var(--border); padding-left: 1.6rem; }
  .nav-login-mobile { display: none; }

  .nav-links { display: flex; align-items: center; gap: 1.6rem; }
  .nav-links > a { font-weight: 600; color: var(--text-secondary); transition: color .15s ease; }
  .nav-links > a:hover { color: var(--ink); text-decoration: none; }
  .nav-links .nav-cta { color: #fff; }
  .nav-links .nav-cta:hover { color: #fff; }

  /* La case à cocher est masquée visuellement mais reste focusable au clavier. */
  .nav-toggle { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; border: 0; overflow: hidden; clip: rect(0 0 0 0); }
  .nav-burger { display: none; }

  @media (max-width: 860px) {
    /* En mobile les deux versions permutent : celle du panneau burger
       disparaît (le filet vertical n'a pas de sens empilé), celle de la barre
       apparaît à côté du burger : la porte d'entrée d'un client reste visible
       sans ouvrir le menu. */
    .nav-login-desktop { display: none; }
    .nav-login-mobile { display: inline; margin-right: .8rem; font-size: .88rem; }

    .nav-burger { display: inline-flex; width: 42px; height: 42px; align-items: center; justify-content: center;
      border: 1px solid var(--border); border-radius: 10px; background: var(--surface); cursor: pointer; }
    .nav-burger span, .nav-burger span::before, .nav-burger span::after { display: block; width: 18px; height: 2px; background: var(--ink); position: relative; border-radius: 2px; }
    .nav-burger span::before { content: ""; position: absolute; top: -6px; }
    .nav-burger span::after { content: ""; position: absolute; top: 6px; }
    .nav-toggle:checked ~ .nav-burger { background: var(--ink); border-color: var(--ink); }
    .nav-toggle:checked ~ .nav-burger span, .nav-toggle:checked ~ .nav-burger span::before, .nav-toggle:checked ~ .nav-burger span::after { background: #fff; }
    .nav-toggle:focus-visible ~ .nav-burger { outline: 2px solid var(--brass); outline-offset: 2px; }

    .nav-links { display: none; position: absolute; right: 0; left: 0; top: 66px; flex-direction: column; align-items: stretch;
      gap: .2rem; background: var(--surface); border: 1px solid var(--border); border-radius: 14px; padding: .75rem; box-shadow: var(--shadow); }
    .nav-toggle:checked ~ .nav-links { display: flex; }
    .nav-links > a { padding: .7rem .6rem; border-radius: 8px; }
    .nav-links > a:hover { background: var(--cream); }
    .nav-cta { text-align: center; margin-top: .4rem; }
  }
</style>
