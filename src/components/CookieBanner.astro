---
import { ANALYTICS } from "../config/site";
// Config passée au script client via un bloc de données JSON (non exécutable,
// conforme à une CSP script-src stricte sans 'unsafe-inline'). Le script de
// consentement ci-dessous est bundlé par Astro (fichier externe servi en 'self').
const cfg = JSON.stringify({ gaId: ANALYTICS.ga4Id, phKey: ANALYTICS.posthogKey, phHost: ANALYTICS.posthogHost, metaId: ANALYTICS.metaPixelId });
---
<script type="application/json" id="stela-analytics" set:html={cfg} />

{/* Bannière de consentement minimale. Progressive enhancement : le contenu du
    site fonctionne sans JavaScript ; la mesure d'audience (GA4 + PostHog) ne se
    charge QU'APRÈS acceptation explicite (Google Consent Mode v2).
    LOT CONSENT-1 : le texte annonce aussi la publicité, car l'acceptation passe
    les signaux publicitaires du Consent Mode v2 (ad_storage, ad_user_data,
    ad_personalization) à « granted ». Le texte doit couvrir ce que le clic
    autorise réellement, pas seulement ce qui est chargé aujourd'hui.
    LOT META-CONFORMITE : c'est la même règle qui fait nommer Meta ici, avant
    que le pixel existe. Le texte décrit ce que le clic autorisera ; le charger
    d'abord et le déclarer ensuite, c'est l'ordre inverse, et c'est la faute. */}
<div id="cookie-banner" class="cookie-banner" hidden>
  <p>Ce site utilise des cookies de mesure d'audience et de publicité (Google, Meta). Vous pouvez les accepter ou les refuser.</p>
  <div class="cookie-actions">
    <button type="button" id="cookie-deny" class="btn btn-ghost">Refuser</button>
    <button type="button" id="cookie-accept" class="btn btn-primary">Accepter</button>
  </div>
</div>

<script>
  // Bundlé par Astro (servi en 'self' depuis /_astro/) : compatible CSP stricte.
  import { readConsent, writeConsent, EMAIL_HASH_KEY, isEmailHash, type TrackParams } from "../lib/track";

  const cfgEl = document.getElementById("stela-analytics");
  const cfg = cfgEl ? JSON.parse(cfgEl.textContent || "{}") : {};
  const banner = document.getElementById("cookie-banner");

  // Google Consent Mode v2 : défaut « denied » avant tout chargement.
  (window as any).dataLayer = (window as any).dataLayer || [];
  // ATTENTION, piège documenté du snippet officiel Google (LOT FIX-GTAG) :
  // gtag.js ne lit QUE les entrées du dataLayer qui sont l'objet `arguments`.
  // Pousser un tableau (`push(args)`) ne provoque aucune erreur, mais TOUT est
  // ignoré en silence : consentement, config et événements. C'est exactement le
  // bug qui a empêché la moindre remontée GA4 depuis le lot GADS-1. On pousse
  // donc `arguments`, jamais `args` (qui n'est là que pour le typage des appels).
  function gtag(..._args: unknown[]) { (window as any).dataLayer.push(arguments); }
  gtag("consent", "default", {
    ad_storage: "denied", analytics_storage: "denied",
    ad_user_data: "denied", ad_personalization: "denied",
  });

  // Émetteur d'événements : branché sur window pour que les pages (via
  // src/lib/track.ts) puissent signaler une conversion sans connaître gtag et
  // sans jamais déclencher de chargement. Tant que rien n'est branché, les
  // pages empilent dans window.stelaQueue.
  const w = window as any;

  /**
   * LOT META-EVENTS-1 : correspondance entre les conversions GA4 deja emises par
   * les pages et les evenements STANDARD du pixel Meta. Standard, et non
   * personnalise : seuls les noms reconnus par Meta (Lead, CompleteRegistration)
   * ouvrent l'optimisation automatique des campagnes. Un nom libre serait
   * accepte sans erreur et ne servirait a rien, c'est-a-dire la meme panne
   * silencieuse que le lot precedent, un cran plus loin.
   *
   * Cette table est le SEUL endroit ou la correspondance existe : les pages
   * continuent d'appeler track() sans rien savoir de Meta, il n'y a donc pas de
   * second chemin de detection a maintenir ni de second endroit ou le
   * consentement pourrait etre oublie.
   */
  const META_STANDARD: Record<string, string> = {
    essai_demarre: "Lead",
    guide_telecharge: "CompleteRegistration",
  };
  /** Déclare `user_data` à partir de la première conversion en attente, si elle
      porte une empreinte. Appelé AVANT `config` : voir loadTrackers(). */
  function declarerUserDataEnAttente() {
    const queued: Array<[string, TrackParams]> = w.stelaQueue || [];
    for (const [, params] of queued) {
      const hash = params?.[EMAIL_HASH_KEY];
      if (isEmailHash(hash)) {
        gtag("set", "user_data", { sha256_email_address: hash });
        return;
      }
    }
  }
  function sendEvent(name: string, params: TrackParams = {}) {
    // LOT GADS-2 : suivi avancé des conversions. La page a pu joindre l'empreinte
    // SHA-256 de l'email sous une clé réservée. On la SORT des paramètres (ce
    // n'est pas un paramètre d'événement GA4, l'envoyer comme tel créerait un
    // doublon inutile) et on la déclare en donnée fournie par l'utilisateur,
    // AVANT l'événement : gtag l'attache alors aux hits qui suivent.
    // On n'arrive ici qu'après « Accepter » : `stelaSend` n'est branché sur cette
    // fonction que dans enableEvents(), donc rien ne peut partir sans consentement.
    const { [EMAIL_HASH_KEY]: hash, ...rest } = params;
    if (isEmailHash(hash)) {
      // Format impose par Google : SHA-256 hexadecimal minuscule de l'email
      // normalise (minuscules, espaces retires). Le hachage a eu lieu dans la
      // page ; ici on ne voit deja plus que l'empreinte.
      gtag("set", "user_data", { sha256_email_address: hash });
    }
    gtag("event", name, rest);
    envoyerAMeta(name);
  }

  /**
   * LOT META-EVENTS-1 : meme conversion, meme instant, deuxieme destinataire.
   * Appele depuis sendEvent(), donc APRES consentement par construction : c'est
   * la meme porte que GA4, il n'y en a pas d'autre. Avant « Accepter »,
   * `stelaSend` n'est pas branche et l'evenement dort dans window.stelaQueue ;
   * apres « Refuser », `stelaSend` est neutre et la file est jetee.
   *
   * AUCUN parametre n'accompagne l'evenement : ni email, ni empreinte de
   * l'email, ni telephone, ni nom. Le suivi avance de GA4 (GADS-2) fait
   * voyager `hash` jusqu'ici ; il s'arrete ici. On ne transmet a Meta que le
   * nom de l'evenement, ce qui suffit a l'optimisation publicitaire.
   */
  function envoyerAMeta(name: string) {
    const evenement = META_STANDARD[name];
    // `w.fbq` n'existe que si le bloc de chargement du pixel s'est execute,
    // c'est-a-dire apres « Accepter » et avec un metaPixelId renseigne. Sinon
    // la conversion part vers GA4 seule, sans erreur.
    if (evenement && typeof w.fbq === "function") w.fbq("track", evenement);
  }
  function enableEvents() {
    w.stelaSend = sendEvent;
    const queued: Array<[string, TrackParams]> = w.stelaQueue || [];
    w.stelaQueue = [];
    for (const [name, params] of queued) sendEvent(name, params);
  }
  function disableEvents() {
    // Refus (ou aucune mesure configurée) : émetteur neutre, file jetée.
    w.stelaSend = () => {};
    w.stelaQueue = [];
  }

  let gaLoaded = false, phLoaded = false, metaLoaded = false;
  /**
   * LOT META-EVENTS-1 : le chargement du pixel devient une fonction pour etre
   * appele AVANT enableEvents(). L'ordre n'est pas cosmetique. Le cas le plus
   * frequent est celui-ci : le visiteur arrive sur /merci-essai, la page appelle
   * track("essai_demarre") qui empile dans window.stelaQueue faute de
   * consentement, puis il clique « Accepter ». enableEvents() vide alors la file
   * immediatement. Si l'amorce fbq n'est pas encore posee a cet instant, la
   * conversion part vers GA4 et se perd pour Meta, sans la moindre erreur : un
   * pixel qui repond et ne mesure pas la conversion, exactement la panne du lot
   * precedent. On amorce donc fbq d'abord ; sa propre file d'attente absorbe le
   * Lead le temps que fbevents.js se charge.
   */
  function loadMetaPixel() {
    // LOT META-CONFORMITE : pixel Meta, sur EXACTEMENT le même interrupteur que
    // GA4. On n'arrive dans loadTrackers() qu'après « Accepter » : un refus ne
    // passe jamais ici, et un visiteur qui n'a rien choisi non plus. Tant que
    // metaPixelId est vide, ce bloc ne fait rien du tout.
    //
    // Pas de repli <noscript><img src="facebook.com/tr"> : ce serait une image
    // tierce chargée depuis le markup statique, donc sans consentement, et le
    // gardien check:analytics la refuse (règle 2, ressource tierce chargée
    // automatiquement). Le pixel n'existe qu'en JavaScript, après le clic.
    if (cfg.metaId && !metaLoaded) {
      metaLoaded = true;
      const w2 = window as any;
      // Amorce officielle fbq, réécrite sans eval ni script inline : la CSP de
      // production interdit 'unsafe-inline' sur script-src.
      const n: any = function (...a: unknown[]) {
        n.callMethod ? n.callMethod.apply(n, a) : n.queue.push(a);
      };
      n.push = n; n.loaded = true; n.version = "2.0"; n.queue = [];
      w2.fbq = w2._fbq = n;
      const m = document.createElement("script");
      m.async = true; m.src = "https://connect.facebook.net/en_US/fbevents.js";
      document.head.appendChild(m);
      // LOT META-PIXEL-1, correction. La version précédente ouvrait par un
      // w2.fbq("consent", "revoke") censé imiter le Consent Mode de gtag. Avec
      // un identifiant vide, ce bloc ne s'exécutait jamais : le défaut est resté
      // invisible jusqu'à ce que le vrai ID le réveille. Mesuré ici, sous la CSP
      // de production : les quatre appels partent AVANT que fbevents.js soit
      // chargé, donc dans la file d'amorce ; fbevents s'arrête de vider cette
      // file sur le « revoke » et n'en repart jamais. Résultat exact observé :
      // fbq.queue reste à [init, grant, track], fbq.getState().pixels est VIDE,
      // aucune requête signals/config ne part. Le script se charge et le pixel
      // ne mesure rien : c'est la signature du bug FIX-GTAG, sur un autre tag.
      //
      // Le « revoke » ne protégeait d'ailleurs de rien : ces appels sont
      // synchrones et le script est async, il ne peut RIEN arriver entre eux.
      // Et on n'entre ici qu'après « Accepter » : le consentement à déclarer est
      // « grant », pas son contraire. On le supprime donc, et le pixel s'initialise.
      w2.fbq("init", cfg.metaId);
      w2.fbq("consent", "grant");
      w2.fbq("track", "PageView");
    }
  }

  function loadTrackers() {
    loadMetaPixel();
    if (cfg.gaId && !gaLoaded) {
      gaLoaded = true;
      // Consent Mode v2 : tout passe à « granted » AVANT le chargement de gtag.
      gtag("consent", "update", {
        ad_storage: "granted", analytics_storage: "granted",
        ad_user_data: "granted", ad_personalization: "granted",
      });
      const s = document.createElement("script");
      s.async = true; s.src = "https://www.googletagmanager.com/gtag/js?id=" + cfg.gaId;
      document.head.appendChild(s);
      gtag("js", new Date());
      // LOT GADS-2 : si une conversion attend déjà en file avec l'empreinte de
      // l'email (cas courant : la page de merci a appelé track() avant que le
      // visiteur ne clique « Accepter »), on déclare la donnée utilisateur AVANT
      // `config`. C'est l'ordre attendu par le tag Google : une donnée déclarée
      // après coup n'est pas reprise dans la configuration initiale du tag.
      declarerUserDataEnAttente();
      // Aucun paramètre superflu, aucun user_id : mesure strictement statistique.
      gtag("config", cfg.gaId, { anonymize_ip: true });
      enableEvents();
    } else if (!cfg.gaId) {
      disableEvents();
    }
    if (cfg.phKey && !phLoaded) {
      phLoaded = true;
      const p = document.createElement("script");
      p.async = true; p.src = cfg.phHost + "/static/array.js";
      p.addEventListener("load", () => {
        const ph = (window as any).posthog;
        if (ph && ph.init) ph.init(cfg.phKey, { api_host: cfg.phHost });
      });
      document.head.appendChild(p);
    }
  }

  // Persistance robuste (src/lib/track.ts) : localStorage d'abord, repli sur un
  // cookie first-party si indisponible (Safari en navigation privée bloque
  // localStorage), durée 6 mois. Le choix vaut pour toutes les pages.
  if (banner) {
    const choice = readConsent();
    if (choice === "granted") {
      loadTrackers();
    } else if (choice === "denied") {
      disableEvents();
    } else {
      banner.hidden = false;
      // Listeners attachés DIRECTEMENT sur chaque bouton (pas de délégation) :
      // fiable sur iOS Safari. Le choix est pris au premier tap.
      const decide = (val: string) => {
        writeConsent(val);
        banner.hidden = true;
        if (val === "granted") loadTrackers(); else disableEvents();
      };
      const accept = document.getElementById("cookie-accept");
      const deny = document.getElementById("cookie-deny");
      accept?.addEventListener("click", () => decide("granted"));
      deny?.addEventListener("click", () => decide("denied"));
    }
  }
</script>

<style>
  /* Cachée par défaut (attribut hidden dans le markup). On NE met PAS display sur
     le sélecteur nu, sinon il l'emporterait sur [hidden] et créerait un flash au
     chargement. Le script retire hidden UNIQUEMENT si aucun choix n'est stocké. */
  .cookie-banner:not([hidden]) { display: flex; gap: 1rem; align-items: center;
    justify-content: space-between; flex-wrap: wrap; }
  .cookie-banner { position: fixed; left: 16px; right: 16px; bottom: 16px; z-index: 80; margin-inline: auto;
    max-width: 720px; background: var(--surface); border: 1px solid var(--border); border-radius: 14px;
    box-shadow: var(--shadow); padding: 1rem 1.25rem; }
  .cookie-banner p { margin: 0; font-size: .9rem; color: var(--text-secondary); flex: 1 1 320px; }
  .cookie-actions { display: flex; gap: .6rem; }
  .cookie-actions .btn { padding: .6rem 1.1rem; font-size: .92rem; }
</style>
