---
// Bande de chiffres FACTUELS (identité Stela), pas de claim de résultat. Les
// compteurs sont animés par le script global de Base (data-count) ; le chiffre
// final est toujours dans le DOM (visible sans JS).
const stats = [
  { n: "10", suffix: "", label: "minutes pour être prêt" },
  { n: "6", suffix: "", label: "langues disponibles" },
  { n: "30", suffix: " s", label: "par avis client" },
  { n: "24", suffix: "h/24", label: "réponses prêtes" },
  { n: "100", suffix: " %", label: "conforme aux règles Google" },
];
---
<section class="statband">
  <div class="container">
    <div class="sb-grid">
      {stats.map((s) => (
        <div class="sb">
          <span class="sb-num" data-count={s.n} data-suffix={s.suffix}>{s.n}{s.suffix}</span>
          <span class="sb-label">{s.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>
<style>
  .statband { background: var(--ink); padding-block: 2.25rem; }
  .sb-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 1.5rem; }
  @media (max-width: 860px) { .sb-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 420px) { .sb-grid { grid-template-columns: 1fr 1fr; gap: 1.25rem; } }
  .sb { text-align: center; }
  .sb-num { display: block; font-size: clamp(2rem, 5vw, 2.8rem); font-weight: 800; color: var(--brass); line-height: 1; letter-spacing: -.02em; }
  .sb-label { display: block; margin-top: .4rem; color: #cdd5e4; font-size: .82rem; font-weight: 600; }
</style>
