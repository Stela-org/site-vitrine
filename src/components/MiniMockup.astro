---
// Mini-visuel produit pour une carte fonctionnalité : reprend le module réel de
// l'app (libellé exact) + 2 lignes de sa maquette. Compact, décoratif.
interface Props { module: string; rows: { label: string; value: string }[]; }
const { module, rows } = Astro.props;
const shown = rows.slice(0, 2);
---
<div class="mm" aria-hidden="true">
  <div class="mm-top"><span class="mm-dot"></span><span class="mm-mod">{module}</span></div>
  {shown.map((r) => (
    <div class="mm-row"><span class="mm-l">{r.label}</span><span class="mm-v">{r.value}</span></div>
  ))}
</div>
<style>
  .mm { background: linear-gradient(180deg, #fff, #fbf9f5); border: 1px solid var(--border);
    border-radius: 12px; padding: .6rem .7rem; margin-bottom: 1rem; }
  .mm-top { display: flex; align-items: center; gap: .4rem; margin-bottom: .5rem; }
  .mm-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--brass); flex: none; }
  .mm-mod { font-size: .72rem; font-weight: 800; color: var(--ink); letter-spacing: .01em; }
  .mm-row { display: flex; justify-content: space-between; gap: .5rem; align-items: center;
    background: var(--surface); border: 1px solid var(--border); border-radius: 8px;
    padding: .35rem .5rem; margin-top: .3rem; }
  .mm-l { font-size: .68rem; font-weight: 600; color: var(--text-secondary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .mm-v { font-size: .66rem; color: var(--text-muted); flex: none; }
</style>
