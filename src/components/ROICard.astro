---
// Carte « Reporting » reprenant le visuel du tableau de bord CRM Stela.
// Chiffres ILLUSTRATIFS (exemple), jamais présentés comme des données client
// réelles (mention explicite + aria-label).
interface Props {
  place?: string; period?: string;
  avis?: string; note?: string; ca?: string; roi?: string;
}
const {
  place = "Le Bistrot du Marais",
  period = "30 derniers jours",
  avis = "+38", note = "4,7", ca = "1 240 €", roi = "6,2×",
} = Astro.props;
---
<div class="rep" role="img" aria-label={`Reporting Stela (exemple illustratif) : ${avis} avis, note ${note}, chiffres illustratifs`}>
  <div class="rep-head">
    <span class="rep-dot" aria-hidden="true"></span>
    <div>
      <p class="rep-title">Reporting</p>
      <p class="rep-place">{place}</p>
    </div>
    <span class="rep-tag">Exemple illustratif</span>
  </div>
  <p class="rep-period">{period}</p>

  <div class="rep-grid">
    <div class="rep-m">
      <span class="rep-k">Nouveaux avis</span>
      <span class="rep-v rep-up">{avis}</span>
    </div>
    <div class="rep-m">
      <span class="rep-k">Note moyenne</span>
      <span class="rep-v">{note} <span class="rep-star" aria-hidden="true">★</span></span>
    </div>
    <div class="rep-m">
      <span class="rep-k">CA estimé</span>
      <span class="rep-v">{ca}</span>
    </div>
    <div class="rep-m rep-m-hl">
      <span class="rep-k">Retour sur investissement</span>
      <span class="rep-v">{roi}</span>
    </div>
  </div>

  <div class="rep-spark" aria-hidden="true">
    {[34, 41, 38, 52, 47, 63, 71].map((h) => <span style={`--h:${h}%`}></span>)}
  </div>
  <p class="rep-foot">Reporting Stela &middot; chiffres illustratifs, non contractuels.</p>
</div>
<style>
  .rep { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 1.25rem; box-shadow: var(--shadow); }
  .rep-head { display: flex; align-items: center; gap: .6rem; }
  .rep-dot { width: 34px; height: 34px; border-radius: 10px; flex: none;
    background: linear-gradient(135deg, var(--brass), var(--gold)); }
  .rep-title { font-weight: 800; color: var(--ink); font-size: 1rem; margin: 0; line-height: 1.1; }
  .rep-place { color: var(--text-muted); font-size: .78rem; margin: 0; }
  .rep-tag { margin-left: auto; font-size: .62rem; font-weight: 800; color: var(--muted, #6C6558);
    background: var(--cream); border: 1px solid var(--border); border-radius: 999px; padding: .2rem .5rem; text-align: right; }
  .rep-period { color: var(--text-muted); font-size: .76rem; margin: .55rem 0 .9rem; }
  .rep-grid { display: grid; grid-template-columns: 1fr 1fr; gap: .6rem; }
  .rep-m { background: var(--cream); border: 1px solid var(--border); border-radius: 12px; padding: .6rem .75rem; }
  .rep-m-hl { background: var(--ink); border-color: var(--ink); }
  .rep-k { display: block; font-size: .68rem; font-weight: 600; color: var(--text-muted); }
  .rep-m-hl .rep-k { color: #9fb0cc; }
  .rep-v { font-size: 1.35rem; font-weight: 800; color: var(--ink); }
  .rep-m-hl .rep-v { color: var(--brass); }
  .rep-up { color: #1c7c54; }
  .rep-star { color: var(--brass); font-size: .9em; }
  .rep-spark { display: flex; align-items: flex-end; gap: 5px; height: 42px; margin: 1rem 0 .6rem; }
  .rep-spark span { flex: 1; height: var(--h); border-radius: 4px 4px 0 0;
    background: linear-gradient(180deg, var(--brass), var(--gold)); }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .rep-spark span { transform: scaleY(0); transform-origin: bottom; animation: rep-rise .7s ease forwards; animation-timeline: view(); animation-range: entry 0% cover 25%; }
    }
  }
  @keyframes rep-rise { to { transform: scaleY(1); } }
  .rep-foot { margin: 0; font-size: .74rem; color: var(--text-muted); }
</style>
