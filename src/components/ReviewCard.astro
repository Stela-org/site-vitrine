---
// Carte d'avis Google réaliste, ANONYMISÉE (initiales, pas de vrai client) et
// présentée par la section comme une ILLUSTRATION du fonctionnement, jamais
// comme un témoignage réel. Étoiles or, réponse du gérant + badge Stela.
interface Props {
  initial: string; // ex. "M."
  name: string; // ex. "Marie L." (anonymisé)
  meta?: string; // ex. "Avis local · il y a 3 jours"
  text: string;
  reply: string;
  featured?: boolean;
}
const { initial, name, meta = "Avis Google", text, reply, featured = false } = Astro.props;
---
<figure class={`rc${featured ? " rc-featured" : ""}`}>
  <div class="rc-head">
    <span class="rc-avatar" aria-hidden="true">{initial}</span>
    <div class="rc-id">
      <span class="rc-name">{name}</span>
      <span class="rc-meta">{meta}</span>
    </div>
    <svg class="rc-g" viewBox="0 0 24 24" width="20" height="20" aria-label="Google" role="img">
      <path fill="#4285F4" d="M23 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.2a5.3 5.3 0 0 1-2.3 3.5v2.9h3.7c2.2-2 3.4-5 3.4-8.6z"/>
      <path fill="#34A853" d="M12 24c3.1 0 5.7-1 7.6-2.8l-3.7-2.9c-1 .7-2.4 1.1-3.9 1.1-3 0-5.5-2-6.4-4.7H1.8v3A11.9 11.9 0 0 0 12 24z"/>
      <path fill="#FBBC05" d="M5.6 14.7a7.1 7.1 0 0 1 0-4.5v-3H1.8a12 12 0 0 0 0 10.5z"/>
      <path fill="#EA4335" d="M12 4.8c1.7 0 3.2.6 4.4 1.7l3.3-3.3A11.8 11.8 0 0 0 12 0 11.9 11.9 0 0 0 1.8 6.2l3.8 3a7.1 7.1 0 0 1 6.4-4.4z"/>
    </svg>
  </div>
  <div class="rc-stars" role="img" aria-label="Note : 5 sur 5">
    {[0, 1, 2, 3, 4].map((i) => <span class="rc-star" style={`--i:${i}`}>★</span>)}
  </div>
  <blockquote class="rc-text">{text}</blockquote>
  <div class="rc-reply">
    <div class="rc-reply-head">
      <span class="rc-reply-glyph" aria-hidden="true">✳</span>
      <span class="rc-reply-title">Réponse du propriétaire</span>
      <span class="rc-badge">répondu par Stela</span>
    </div>
    <p class="rc-reply-text">{reply}</p>
  </div>
</figure>
<style>
  .rc { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 1.25rem;
    box-shadow: var(--shadow); margin: 0; }
  .rc-featured { border-color: var(--brass); box-shadow: 0 14px 40px rgba(21,35,63,.14); }
  .rc-head { display: flex; align-items: center; gap: .7rem; }
  .rc-avatar { width: 40px; height: 40px; border-radius: 50%; background: var(--accentBlueTint, #EAF2FB);
    color: var(--ink); font-weight: 800; display: grid; place-items: center; flex: none; }
  .rc-id { display: flex; flex-direction: column; line-height: 1.2; }
  .rc-name { font-weight: 700; color: var(--ink); font-size: .95rem; }
  .rc-meta { color: var(--text-muted); font-size: .78rem; }
  .rc-g { margin-left: auto; }
  .rc-stars { display: flex; gap: 2px; margin: .7rem 0 .5rem; font-size: 1.1rem; letter-spacing: 1px; }
  .rc-star { color: #E7B008; }
  .rc-text { margin: 0 0 1rem; color: var(--text-secondary); font-size: .95rem; line-height: 1.6; }
  .rc-text::before { content: "\201C"; }
  .rc-text::after { content: "\201D"; }
  .rc-reply { background: var(--cream); border-radius: 12px; padding: .85rem .95rem; border: 1px solid var(--border); }
  .rc-reply-head { display: flex; align-items: center; gap: .45rem; margin-bottom: .35rem; flex-wrap: wrap; }
  .rc-reply-glyph { color: var(--brass); font-weight: 800; }
  .rc-reply-title { font-weight: 700; font-size: .82rem; color: var(--ink); }
  .rc-badge { margin-left: auto; font-size: .68rem; font-weight: 700; color: var(--brass);
    background: rgba(176,138,62,.12); border-radius: 999px; padding: .12rem .5rem; }
  .rc-reply-text { margin: 0; font-size: .86rem; color: var(--text-secondary); line-height: 1.55; }
</style>
