---
// Pictogrammes des cartes métier de la home (VIT-19). Ils remplacent les 7
// emojis qui tenaient ce rôle : un emoji change de dessin selon l'OS, arrive
// en couleurs qui ne sont pas les nôtres, et grossit mal dans un carré de
// 40 px. Ces tracés-là sont dessinés à la main, monochromes, et héritent de
// la couleur du contexte via `currentColor` - la classe .segment-ic pose
// `color: var(--brass)`, comme .ps-glyph le fait pour le glyphe de marque.
//
// Meme grammaire que le reste du site (FeatureVisual) : trait seul, pas de
// remplissage, 1.6 d'epaisseur sur une grille de 24, bouts et angles arrondis.
// Decoratif : le libelle de la carte porte le sens, l'icone est aria-hidden.
//
// Ajouter un secteur = ajouter une entree ici ET la cle correspondante dans
// `icon` du segment (src/content/segments.ts). Une cle inconnue ne dessine
// rien plutot que de casser la page.
interface Props { name: string; class?: string; }
const { name, class: cls } = Astro.props;
---
<svg
  class={cls}
  viewBox="0 0 24 24"
  width="22"
  height="22"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === "boutique" && (
    <g>
      {/* Devanture : store en auvent, vitrine, porte. */}
      <path d="M3.5 7.5 5 3.5h14l1.5 4" />
      <path d="M3.5 7.5a2.2 2.2 0 0 0 4.25 0 2.2 2.2 0 0 0 4.25 0 2.2 2.2 0 0 0 4.25 0 2.2 2.2 0 0 0 4.25 0" />
      <path d="M4.8 10v10.5h14.4V10" />
      <path d="M9.8 20.5V14h4.4v6.5" />
    </g>
  )}
  {name === "immeubles" && (
    <g>
      {/* Plusieurs adresses : deux batiments, l'un derriere l'autre. */}
      <path d="M3.5 20.5V8.2l6-3.2v15.5" />
      <path d="M9.5 20.5V10h11v10.5" />
      <path d="M2.5 20.5h19" />
      <path d="M13 13.5h1.2M17 13.5h1.2M13 17h1.2M17 17h1.2M6 11h1.2M6 14.5h1.2" />
    </g>
  )}
  {name === "couverts" && (
    <g>
      {/* Restaurant : fourchette et couteau. */}
      <path d="M7 3v6.5a2 2 0 0 0 2 2 2 2 0 0 0 2-2V3" />
      <path d="M9 11.5V21" />
      <path d="M16.5 3c1.6 1.3 2.3 3.2 2.3 5.5 0 1.9-.8 3.1-2.3 3.4V21" />
    </g>
  )}
  {name === "ciseaux" && (
    <g>
      {/* Coiffeur : ciseaux ouverts. */}
      <circle cx="6.5" cy="18" r="2.6" />
      <circle cx="17.5" cy="18" r="2.6" />
      <path d="M8.4 16.1 19 3.5" />
      <path d="M15.6 16.1 5 3.5" />
      <path d="m11 11 1.6 1.9" />
    </g>
  )}
  {name === "goutte" && (
    <g>
      {/* Institut : goutte de soin. Une fleur a quatre petales avait ete
          essayee d'abord : a 22 px ses petales se referment en etincelle, et
          l'etincelle est deja le glyphe de marque. La goutte reste lisible a
          cette taille et ne ressemble a aucune des six autres. */}
      <path d="M12 3.2c0 0-6.4 6.6-6.4 10.8a6.4 6.4 0 0 0 12.8 0C18.4 9.8 12 3.2 12 3.2Z" />
      <path d="M9 14.6a3 3 0 0 0 2.3 2.9" />
    </g>
  )}
  {name === "cle-plate" && (
    <g>
      {/* Garage : cle plate en diagonale. */}
      <path d="M15.6 3.2a5.4 5.4 0 0 0-4.3 8.7L3.6 19.6a1.8 1.8 0 0 0 2.5 2.5l7.7-7.7a5.4 5.4 0 0 0 6.6-8.1l-2.9 2.9-2.7-.7-.7-2.7 2.9-2.9a5.4 5.4 0 0 0-1.4-.2Z" />
    </g>
  )}
  {name === "lit" && (
    <g>
      {/* Hotel : lit vu de cote, tete de lit et oreiller. */}
      <path d="M3 20.5v-13" />
      <path d="M3 12.5h18v8" />
      <path d="M3 17h18" />
      <path d="M6 12.5v-2.8h4.2v2.8" />
    </g>
  )}
</svg>
