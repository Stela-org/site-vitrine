---
import "../styles/global.css";
import { SITE, analyticsEnabled } from "../config/site";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import CookieBanner from "../components/CookieBanner.astro";
import StickyCta from "../components/StickyCta.astro";
import PartnerCode from "../components/PartnerCode.astro";
import ClosingBlock from "../components/ClosingBlock.astro";

interface Props {
  title: string;
  description: string;
  /** Chemin canonique, ex. "/" ou "/tarifs". */
  path?: string;
  ogImage?: string;
  /** Pages légales : exclues de l'indexation. */
  noindex?: boolean;
  /** Bloc de closing commun en bas de page (essai 7 j + garantie + rendez-vous).
   *  Actif par défaut ; désactivé sur les pages légales / de service. */
  closing?: boolean;
}

const { title, description, path = "/", ogImage = "/images/og-default.png", noindex = false, closing = true } = Astro.props;
const canonical = new URL(path, SITE.url).href;
const ogImageAbs = new URL(ogImage, SITE.url).href;

// Schema.org : Organization + SoftwareApplication (+ Offer, prix réels).
const orgLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: SITE.brand,
  url: SITE.url,
  slogan: SITE.tagline,
  email: SITE.email,
  // LOT SEO-LOGO : PNG et non SVG. Google IGNORE les logos vectoriels pour la
  // vignette des resultats de recherche : il exige un format matriciel. Le SVG
  // reste le logo du SITE ; celui-ci n'existe que pour le balisage.
  logo: new URL("/images/logo-monogramme-512.png", SITE.url).href,
  sameAs: SITE.sameAs,
  founder: { "@type": "Person", name: "Nicolas Anquetin", jobTitle: "Cofondateur", url: new URL("/notre-histoire", SITE.url).href },
};
const appLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: SITE.brand,
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  // LOT SEO-GEO-1 §A1 : ce champ portait le POSITIONNEMENT, une phrase écrite
  // pour convaincre. Il porte maintenant la DÉFINITION, écrite pour être citée.
  // C'est la nature du champ qui commande : un `description` de JSON-LD est lu
  // par des machines qui en reprennent le contenu tel quel, pas par un
  // prospect à séduire. Le positionnement n'est pas retiré du site pour autant,
  // il reste la ligne du pied de page, à sa place, sur une surface humaine.
  description: SITE.definition,
  offers: [
    { "@type": "Offer", name: "Étoile", price: "49", priceCurrency: "EUR", category: "mensuel" },
    { "@type": "Offer", name: "Constellation", price: "89", priceCurrency: "EUR", category: "mensuel" },
    { "@type": "Offer", name: "Étoile (annuel)", price: "468", priceCurrency: "EUR", category: "annuel" },
    { "@type": "Offer", name: "Constellation (annuel)", price: "948", priceCurrency: "EUR", category: "annuel" },
  ],
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <meta name="google-site-verification" content={SITE.googleSiteVerification} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:locale" content="fr_FR" />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#15233F" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/images/glyphe-laiton.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/glyphe-brass-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/images/glyphe-brass-16.png" />
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(appLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Aller au contenu</a>
    <Nav />
    <main id="main">
      <slot />
      {closing && <ClosingBlock />}
    </main>
    <Footer />
    {analyticsEnabled() && <CookieBanner />}
    <StickyCta />
    <PartnerCode />

    <script>
      // Compteurs animés (progressive enhancement, bundlé = CSP 'self'). Le
      // chiffre FINAL est toujours dans le DOM : sans JS ou sous reduced-motion,
      // il s'affiche directement. Anime tout élément [data-count] à l'entrée.
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const nums = document.querySelectorAll<HTMLElement>("[data-count]");
      if (nums.length && !reduce && "IntersectionObserver" in window) {
        const io = new IntersectionObserver((entries, obs) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            obs.unobserve(e.target);
            const el = e.target as HTMLElement;
            const target = parseFloat(el.dataset.count || "0");
            const suffix = el.dataset.suffix || "";
            const sign = target < 0 ? "-" : "";
            const abs = Math.abs(target);
            const dur = 900; let start = 0;
            const tick = (t: number) => {
              if (!start) start = t;
              const p = Math.min((t - start) / dur, 1);
              el.textContent = sign + Math.round(abs * p) + suffix;
              if (p < 1) requestAnimationFrame(tick); else el.textContent = sign + abs + suffix;
            };
            requestAnimationFrame(tick);
          }
        }, { threshold: 0.4 });
        nums.forEach((n) => io.observe(n));
      }

      // Tunnel : le toggle mensuel/annuel bascule chaque bouton de plan sur le
      // BON Payment Link Stripe (les deux URL sont dans data-href-*). PE : sans
      // JS, le lien reste le lien mensuel (href par défaut).
      const billingToggle = document.getElementById("billing") as HTMLInputElement | null;
      const planCtas = document.querySelectorAll<HTMLAnchorElement>("[data-plan-cta]");
      if (billingToggle && planCtas.length) {
        const syncBilling = () => {
          planCtas.forEach((a) => {
            const href = billingToggle.checked ? a.dataset.hrefYearly : a.dataset.hrefMonthly;
            if (href) a.href = href;
          });
        };
        billingToggle.addEventListener("change", syncBilling);
        syncBilling();
      }
    </script>
  </body>
</html>
