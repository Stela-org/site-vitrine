---
import Base from "../layouts/Base.astro";
import AppMockup from "../components/AppMockup.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import { SITE , TARIFS_URL } from "../config/site";
import { FEATURES } from "../content/features";

export function getStaticPaths() {
  return FEATURES.map((f) => ({ params: { feature: f.slug }, props: { f } }));
}

const { f } = Astro.props;
const url = new URL(`/${f.slug}`, SITE.url).href;

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: f.faq.map((q) => ({
    "@type": "Question", name: q.q,
    acceptedAnswer: { "@type": "Answer", text: q.a },
  })),
};
// Maillage : les autres fonctionnalités.
const others = FEATURES.filter((x) => x.slug !== f.slug);
---
<Base title={f.title} description={f.metaDescription} path={`/${f.slug}`}>
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} is:inline />

  <div class="container"><Breadcrumb items={[{ label: "Fonctionnalités", href: "/fonctionnalites" }, { label: f.navLabel }]} /></div>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">{f.keyword}</p>
        <h1>{f.h1}</h1>
        <p class="lead">{f.lead}</p>
        <div class="hero-cta">
          <a class="btn btn-primary" href={TARIFS_URL}>Essai gratuit 7 jours</a>
          <a class="btn btn-ghost" href="/tarifs">Voir les tarifs</a>
        </div>
      </div>
      <AppMockup active={f.mockup.module} heading={f.mockup.heading} rows={f.mockup.rows} />
    </div>
  </section>

  <section>
    <div class="container">
      <h2>Ce que ça change pour vous</h2>
      <div class="grid-3 reveal-stagger">
        {f.benefits.map((b) => (
          <div class="card"><h3>{b.t}</h3><p>{b.d}</p></div>
        ))}
      </div>
    </div>
  </section>

  {f.seo && (
    <section class="seo-sec">
      <div class="container">
        <p class="eyebrow">Visibilité</p>
        <h2>{f.seo.title}</h2>
        <p class="seo-intro">{f.seo.intro}</p>
        <div class="seo-ba">
          <div class="seo-card seo-before">
            <span class="seo-tag">Une réponse simple</span>
            <p class="seo-reply">{f.seo.before}</p>
            <p class="seo-note">Correcte, mais elle n'aide pas votre fiche.</p>
          </div>
          <div class="seo-arrow" aria-hidden="true">→</div>
          <div class="seo-card seo-after">
            <span class="seo-tag seo-tag-on">La même, écrite par Nova</span>
            <p class="seo-reply">
              {f.seo.afterTokens.map((tk) => (tk.kw ? <span class="seo-kw">{tk.t}</span> : <span>{tk.t}</span>))}
            </p>
            <p class="seo-note">Les mots que vos clients tapent sur Google, glissés naturellement.</p>
          </div>
        </div>
      </div>
    </section>
  )}

  <section class="steps-sec">
    <div class="container">
      <h2>Comment ça marche</h2>
      <ol class="steps reveal-stagger">
        {f.steps.map((s, i) => (
          <li><span class="step-n">{i + 1}</span><div><h3>{s.t}</h3><p>{s.d}</p></div></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="faq">
    <div class="container">
      <h2>Questions fréquentes</h2>
      <div class="faq-list reveal-stagger">
        {f.faq.map((q) => (
          <div class="faq-item"><h3>{q.q}</h3><p>{q.a}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="others">
    <div class="container">
      <h2>Explorer les autres fonctionnalités</h2>
      <div class="others-links">
        {others.map((o) => <a href={`/${o.slug}`} class="others-link">{o.navLabel}</a>)}
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { background: linear-gradient(180deg, #fff 0%, var(--cream) 100%); padding-block: clamp(40px, 6vw, 80px); }
  .hero-grid { display: grid; grid-template-columns: 1.05fr .95fr; gap: 3rem; align-items: center; }

  /* Section SEO (VIT-9c) : avant/après d'une réponse, mots-clés soulignés. */
  .seo-sec { background: var(--cream); }
  .seo-intro { color: var(--text-secondary); max-width: 68ch; margin-top: .5rem; }
  .seo-ba { display: grid; grid-template-columns: 1fr auto 1fr; gap: 1rem; align-items: stretch; margin-top: 1.25rem; }
  @media (max-width: 720px) { .seo-ba { grid-template-columns: 1fr; } .seo-arrow { transform: rotate(90deg); justify-self: center; } }
  .seo-card { background: #fff; border: 1px solid var(--border); border-radius: 14px; padding: 1rem 1.1rem; }
  .seo-after { border-color: var(--brass); box-shadow: 0 10px 30px rgba(176,138,62,.12); }
  .seo-arrow { align-self: center; color: var(--brass); font-weight: 800; font-size: 1.5rem; }
  .seo-tag { display: inline-block; font-size: .68rem; font-weight: 800; text-transform: uppercase; letter-spacing: .06em;
    color: var(--text-muted); background: var(--cream); border-radius: 999px; padding: .18rem .55rem; margin-bottom: .5rem; }
  .seo-tag-on { color: var(--royal); background: rgba(176,138,62,.12); }
  .seo-reply { color: var(--ink); font-size: 1rem; margin: 0 0 .5rem; line-height: 1.5; }
  .seo-kw { text-decoration: underline; text-decoration-color: var(--brass); text-decoration-thickness: 2px;
    text-underline-offset: 3px; font-weight: 600; }
  .seo-note { font-size: .8rem; color: var(--text-muted); margin: 0; }
  @media (max-width: 900px) { .hero-grid { grid-template-columns: 1fr; } }
  .crumbs { font-size: .85rem; color: var(--text-muted); margin-bottom: .75rem; }
  .crumbs a { color: var(--text-muted); } .crumbs span { margin: 0 .35rem; }
  .hero-cta { display: flex; gap: .75rem; flex-wrap: wrap; margin-top: 1.5rem; }
  .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; margin-top: 1.5rem; }
  @media (max-width: 860px) { .grid-3 { grid-template-columns: 1fr; } }
  .steps-sec { background: #fff; }
  .steps { list-style: none; padding: 0; margin: 1.5rem 0 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
  @media (max-width: 860px) { .steps { grid-template-columns: 1fr; } }
  .steps li { display: flex; gap: .9rem; align-items: flex-start; }
  .step-n { flex: none; width: 34px; height: 34px; border-radius: 50%; background: var(--ink); color: #fff;
    display: grid; place-items: center; font-weight: 800; }
  .faq-list { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; margin-top: 1.5rem; }
  @media (max-width: 760px) { .faq-list { grid-template-columns: 1fr; } }
  .faq-item h3 { margin-bottom: .35rem; }
  .others { background: var(--cream); }
  .others-links { display: flex; flex-wrap: wrap; gap: .6rem; margin-top: 1rem; }
  .others-link { background: #fff; border: 1px solid var(--border); border-radius: 999px; padding: .5rem 1rem; font-weight: 600; }
  .cta-final { background: var(--ink); text-align: center; }
  .cta-final h2 { color: #fff; margin-bottom: 1.5rem; }
</style>
