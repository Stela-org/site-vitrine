---
import Base from "../../layouts/Base.astro";
import { SITE , TARIFS_URL, PLANS } from "../../config/site";
import { SEGMENTS, profils, secteurs } from "../../content/segments";
import { CITIES } from "../../content/cities";
import ReviewCard from "../../components/ReviewCard.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { CALENDAR_URL } from "../../../lib/booking.js";

export function getStaticPaths() {
  return SEGMENTS.map((s) => ({ params: { segment: s.slug }, props: { s } }));
}
const { s } = Astro.props;
const url = new URL(`/pour/${s.slug}`, SITE.url).href;

const faqLd = {
  "@context": "https://schema.org", "@type": "FAQPage",
  mainEntity: s.faq.map((q) => ({ "@type": "Question", name: q.q, acceptedAnswer: { "@type": "Answer", text: q.a } })),
};
const otherProfils = profils().filter((x) => x.slug !== s.slug);
const otherSecteurs = secteurs().filter((x) => x.slug !== s.slug);
---
<Base title={s.title} description={s.metaDescription} path={`/pour/${s.slug}`}>
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} is:inline />

  <div class="container"><Breadcrumb items={[{ label: "Fonctionnalités", href: "/fonctionnalites" }, { label: s.navLabel }]} /></div>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">{s.kind === "secteur" ? "Par secteur" : "Par profil"}</p>
        <h1>{s.h1}</h1>
        <p class="lead">{s.lead}</p>
        <div class="hero-cta">
          {s.surDevis ? (
            <a class="btn btn-primary" href="#devis">Demander un devis</a>
          ) : (
            <>
              <a class="btn btn-primary" href={TARIFS_URL}>Essai gratuit 7 jours</a>
              <a class="btn btn-ghost" href="/tarifs">Voir les tarifs</a>
            </>
          )}
        </div>
      </div>
      <div class="hero-review">
        <ReviewCard initial="C." name="Client vérifié" meta="Avis Google · exemple"
          text={s.heroReview.text} reply={s.heroReview.reply} featured />
      </div>
    </div>
  </section>

  {/* VIT-15 §4 : preuve dans le vocabulaire DU métier (avis d'exemple dédiés). */}
  <section class="seg-reviews">
    <div class="container">
      <p class="eyebrow">Voici ce que ça donne</p>
      <h2>Des avis {s.kind === "secteur" ? "de votre secteur" : "de vos clients"}, des réponses déjà prêtes</h2>
      <p class="section-lead">Exemples illustratifs, avis anonymisés. Nova rédige la réponse, vous relisez et vous envoyez.</p>
      <div class="seg-reviews-band reveal-stagger">
        {s.reviewExamples.map((r, i) => (
          <ReviewCard initial="C." name="Client vérifié" meta="Avis Google · exemple"
            text={r.text} reply={r.reply} featured={i === 0} />
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <h2 class="seg-points-title">Ce que Stela fait pour vous</h2>
      <div class="grid-3 reveal-stagger">
        {s.points.map((p) => (
          <div class="card"><h3>{p.t}</h3><p>{p.d}</p></div>
        ))}
      </div>
    </div>
  </section>

  {/* VIT-15 §4 : tarifs (aperçu) sur la landing métier, prix transparents.
      Multi-établissements (surDevis) : offre sur mesure, pas de grille 49/89. */}
  <section class="seg-tarifs">
    <div class="container">
      {s.surDevis ? (
        <>
          <p class="eyebrow">Tarifs sur mesure</p>
          <h2 id="devis">Une offre adaptée à votre réseau</h2>
          <p class="seg-devis-lead">
            Chaque groupe est différent : nombre d'établissements, volumes d'avis,
            besoins d'équipe. On construit l'offre avec vous, sur devis. Dites-nous
            qui vous êtes, puis choisissez un créneau de rendez-vous.
          </p>

          {/* LOT DEVIS-1 §3 : la validation serveur redirigeait avec `?erreur=`
              et le HTML n'en disait rien. Rempli par le script à partir de la
              liste des champs refusés. */}
          <div id="devis-erreur" class="devis-erreur" hidden role="alert">
            <p class="devis-erreur-title">Votre demande n'a pas été envoyée.</p>
            <ul id="devis-erreur-liste" class="devis-erreur-liste"></ul>
          </div>

          <form method="POST" action="/api/devis" class="devis-form card">
            {/* Honeypot anti-bot : invisible, doit rester vide. */}
            <div class="hp" aria-hidden="true">
              <label>Ne pas remplir<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
            </div>
            {/* LOT DEVIS-5 : la page est paramétrée, la fonction serveur doit
                savoir vers quelle landing renvoyer. Le slug voyage avec la
                soumission plutôt que d'être codé en dur côté serveur ; il y est
                strictement filtré avant d'entrer dans l'URL de redirection. */}
            <input type="hidden" name="segment" value={s.slug} />
            <label class="devis-field">Votre nom
              <input type="text" name="name" required placeholder="Camille Dupont" autocomplete="name" maxlength="80" />
            </label>
            {/* LOT GADS-2 : l'email manquait au formulaire. Il sert deux fois :
                répondre au prospect sans dépendre du seul créneau pris, et
                joindre son empreinte SHA-256 à la conversion `demande_devis`. */}
            <label class="devis-field">Votre email professionnel
              <input type="email" name="email" required placeholder="vous@etablissement.fr" autocomplete="email" maxlength="120" aria-describedby="devis-email-hint" />
            </label>
            {/* LOT DEVIS-1 §4 : incitation, jamais blocage. Beaucoup de
                restaurateurs indépendants, y compris multi-sites, pilotent leur
                groupe depuis une adresse Gmail. Refuser la saisie coûterait de
                vrais prospects sur la conversion la plus chère du site. */}
            <p class="devis-hint" id="devis-email-hint" hidden>
              Une adresse professionnelle nous aide à préparer votre devis.
            </p>
            {/* LOT DEVIS-4 §3 : le stepper natif disparaît. Ses flèches font 12 px
                de haut, se ratent au pouce, et n'existent tout simplement pas sur
                plusieurs navigateurs mobiles.
                Choix : DEUX BOUTONS ET UNE VALEUR AU CENTRE, pas une rangée de
                choix rapides. Un seul contrôle plutôt que deux qui se
                concurrencent, et surtout aucune valeur « 20+ » : le serveur
                attend un nombre, un raccourci non numérique aurait obligé à
                garder un champ libre à côté, donc à afficher deux fois la même
                information. La valeur reste un vrai champ de saisie : 47
                s'écrit directement, sans 47 clics. */}
            <div class="devis-field">
              <label class="devis-field-label" for="devis-etab">Nombre d'établissements</label>
              <div class="devis-stepper">
                <button type="button" class="devis-step" id="devis-moins" aria-label="Un établissement de moins">&minus;</button>
                <input id="devis-etab" type="text" name="establishments" required inputmode="numeric"
                  pattern="[0-9]{1,6}" autocomplete="off" placeholder="4" aria-describedby="devis-etab-aide" />
                <button type="button" class="devis-step" id="devis-plus" aria-label="Un établissement de plus">+</button>
              </div>
              <p class="devis-hint" id="devis-etab-aide">Flèches haut et bas au clavier, ou saisissez le nombre exact.</p>
            </div>
            <label class="devis-field">Votre secteur
              <select name="sector" required>
                <option value="" disabled selected>Choisissez votre secteur</option>
                <option>Restauration</option>
                <option>Coiffure</option>
                <option>Institut de beauté</option>
                <option>Garage automobile</option>
                <option>Hôtellerie</option>
                <option>Commerce de détail</option>
                <option>Autre</option>
              </select>
            </label>
            <button type="submit" class="btn btn-primary" id="devis-submit">Demander un devis et choisir un créneau</button>
            {/* LOT DEVIS-1 §1 : jusqu'ici, on soumettait dans le vide. Si le
                calendrier tardait à charger, rien ne disait que la demande
                partait. */}
            <p class="devis-status" id="devis-status" role="status" hidden>Envoi en cours, ne fermez pas cette page.</p>
            {/* Filet de sécurité (DEVIS-1b, reformulé en DEVIS-4). Il ne parle
                plus du calendrier, qui ne s'ouvre plus tout seul : il couvre
                désormais la soumission elle-même, seule étape qui puisse encore
                laisser le visiteur devant un écran figé. */}
            <p class="devis-secours" id="devis-secours" role="alert" hidden>
              L'envoi n'a pas abouti. Réessayez, ou prenez directement un créneau :
              <a href={CALENDAR_URL} rel="noopener">choisir un créneau</a>
            </p>
          </form>
          {/* LOT DEVIS-1 §2 : cette offre se close en appel, jamais par email.
              L'ancienne note (« Réponse sous 24 h ouvrées ») laissait croire
              qu'attendre suffirait, et sabordait la prise de créneau. */}
          <p class="seg-tarifs-note">Vous choisissez votre créneau juste après l'envoi. 15 minutes, sans engagement.</p>

          {/* LOT DEVIS-4 §1 : la confirmation passe SOUS le formulaire. Au-dessus,
              elle repoussait le formulaire hors de l'écran et donnait à croire
              que la page s'était réinitialisée. Ici, elle se lit comme la suite
              naturelle du geste qu'on vient de faire. Le script y amène par un
              défilement doux, sans jamais déplacer le visiteur de force. */}
          {/* LOT DEVIS-5 : l'encart n'est plus masqué par l'attribut `hidden`
              mais par du CSS, et il se révèle SEUL quand l'URL pointe sur lui
              (`:target`). Deux conséquences voulues : il s'affiche sans une
              ligne de JavaScript, et le navigateur peut s'y positionner
              nativement au chargement, ce que `hidden` interdisait. La classe
              `est-visible` couvre le second cas, celui du visiteur qui revient
              plus tard sans ancre dans l'URL. */}
          <div id="devis-confirm" class="devis-confirm">
            <p class="devis-confirm-title">Votre demande est enregistrée.</p>
            <p class="devis-confirm-text">
              Il reste l'essentiel : choisir le moment où on en parle. Une offre de
              groupe se construit pendant l'échange, pas par email.
            </p>
            <a class="btn btn-primary" id="devis-calendrier" href={CALENDAR_URL} rel="noopener">Choisir un créneau, 15 minutes</a>
            <button type="button" class="devis-confirm-redo" id="devis-redo">Envoyer une autre demande</button>
          </div>
        </>
      ) : (
        <>
          <p class="eyebrow">Tarifs transparents</p>
          <h2>Un prix clair, essai gratuit de 7 jours</h2>
          <div class="seg-plans">
            {PLANS.map((p) => (
              <div class={`seg-plan${"highlight" in p && p.highlight ? " seg-plan-hl" : ""}`}>
                <p class="seg-plan-name">{p.name}</p>
                <p class="seg-plan-price"><strong>{p.monthly} €</strong> / mois</p>
                <p class="seg-plan-tag">{p.tagline}</p>
              </div>
            ))}
          </div>
          <div class="seg-tarifs-cta">
            <a class="btn btn-primary" href={TARIFS_URL}>Essai gratuit 7 jours</a>
            <a class="btn btn-ghost" href="/tarifs">Voir le détail des offres</a>
          </div>
          <p class="seg-tarifs-note">Sans engagement, annulable en un clic. En annuel, 2 mois offerts.</p>
        </>
      )}
    </div>
  </section>

  <section class="faq">
    <div class="container">
      <h2>Questions fréquentes</h2>
      <div class="faq-list reveal-stagger">
        {s.faq.map((q) => (
          <div class="faq-item"><h3>{q.q}</h3><p>{q.a}</p></div>
        ))}
      </div>
    </div>
  </section>

  {s.slug === "restaurant" && (
    <section class="others">
      <div class="container">
        <h2>Stela pour les restaurants, ville par ville</h2>
        <div class="others-links">
          {CITIES.map((c) => (
            <a href={`/restaurants-${c.slug}`} class="others-link">Restaurants {c.prep}</a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="others">
    <div class="container">
      <h2>Stela s'adapte à votre situation</h2>
      <div class="others-links">
        {[...otherProfils, ...otherSecteurs].map((o) => (
          <a href={`/pour/${o.slug}`} class="others-link">{o.navLabel}</a>
        ))}
      </div>
    </div>
  </section>
</Base>

<script>
  // Conversion `demande_devis` au submit VALIDE du formulaire (page
  // /pour/multi-etablissements uniquement : ailleurs, le formulaire n'existe pas
  // et ce script ne fait rien). Le POST /api/devis redirige vers un site externe
  // (calendrier) : l'événement part en transport 'beacon' pour survivre à la
  // navigation, SANS preventDefault ni délai, donc sans retarder l'envoi.
  // Le submit natif n'est émis que si la validation HTML passe, et le honeypot
  // rempli (bot) est exclu.
  //
  // LOT GADS-2 : l'empreinte SHA-256 de l'email saisi accompagne la conversion.
  // Elle est calculée À LA SAISIE et non au submit : crypto.subtle est
  // asynchrone, or le submit natif quitte la page immédiatement, attendre le
  // hachage à ce moment-là reviendrait soit à retarder l'envoi, soit à le rater.
  // Au submit, l'empreinte est donc déjà prête et se lit sans await.
  import { trackWithEmailHash, hashEmail } from "../../lib/track";
  const devis = document.querySelector<HTMLFormElement>(".devis-form");
  const emailInput = devis?.querySelector<HTMLInputElement>('input[name="email"]');
  let emailHash: string | null = null;
  if (emailInput) {
    let derniere = "";
    const preparer = () => {
      const saisie = emailInput.value;
      if (saisie === derniere) return;
      derniere = saisie;
      // Saisie invalide ou incomplète : hashEmail rend null, et la conversion
      // partira sans empreinte plutôt qu'avec une valeur approximative.
      hashEmail(saisie).then((h) => { emailHash = h; });
    };
    emailInput.addEventListener("input", preparer);
    emailInput.addEventListener("change", preparer);
  }
  // ── LOT DEVIS-1 ───────────────────────────────────────────────────────────
  // Trois manques traités ici, tous côté client : la page est statique et le
  // POST part vers une fonction serveur qui redirige hors du site.
  //
  //   §1 état d'envoi : on soumettait dans le vide.
  //   §2 le rendez-vous EST l'étape, pas une suite optionnelle : on mémorise
  //      qu'une demande est partie pour ramener au calendrier le visiteur qui
  //      revient sans avoir réservé, sans lui refaire remplir le formulaire.
  //   §3 les erreurs de validation serveur, jusqu'ici invisibles.
  //
  // La mémorisation utilise localStorage, jamais un cookie de mesure : c'est un
  // état fonctionnel déclenché par le visiteur lui-même (il vient d'envoyer un
  // formulaire), sans lien avec le consentement publicitaire de la bannière.
  const DEVIS_KEY = "stela_devis_envoye";
  const DEVIS_TTL_MS = 30 * 24 * 3600 * 1000;

  const MESSAGES: Record<string, string> = {
    nom: "Indiquez votre nom, pour qu'on sache à qui l'on s'adresse.",
    email: "L'adresse email saisie n'est pas valide, vérifiez sa forme (vous@etablissement.fr).",
    etablissements: "Indiquez le nombre d'établissements, en chiffres (par exemple 4).",
    secteur: "Choisissez votre secteur dans la liste.",
  };
  const CHAMPS: Record<string, string> = {
    nom: "name", email: "email", etablissements: "establishments", secteur: "sector",
  };
  const GENERIQUE = "Votre demande n'a pas pu être lue. Vérifiez les champs et réessayez.";

  // §4 : fournisseurs grand public. Liste volontairement courte et explicite ;
  // elle ne sert qu'à afficher un conseil, jamais à refuser une saisie.
  const GRAND_PUBLIC = [
    "gmail", "googlemail", "yahoo", "ymail", "hotmail", "outlook", "live", "msn",
    "orange", "wanadoo", "free", "sfr", "neuf", "bbox", "laposte", "icloud", "me",
    "aol", "gmx", "protonmail", "proton",
  ];

  const memoriser = () => {
    try { localStorage.setItem(DEVIS_KEY, String(Date.now())); } catch { /* navigation privée : on continue sans */ }
  };
  const demandeEnvoyee = (): boolean => {
    try {
      const brut = localStorage.getItem(DEVIS_KEY);
      if (!brut) return false;
      const quand = Number(brut);
      if (!Number.isFinite(quand) || Date.now() - quand > DEVIS_TTL_MS) {
        localStorage.removeItem(DEVIS_KEY);
        return false;
      }
      return true;
    } catch { return false; }
  };

  if (devis) {
    // L'URL du calendrier est lue sur le bouton de la confirmation plutôt que
    // recopiée ici : le lien affiché et la destination du saut ne peuvent alors
    // pas diverger, et il n'y a toujours qu'un seul endroit à changer.
    const CALENDRIER = document.querySelector<HTMLAnchorElement>("#devis-calendrier")?.href || "";
    const bouton = document.querySelector<HTMLButtonElement>("#devis-submit");
    const statut = document.querySelector<HTMLElement>("#devis-status");
    const bloc = document.querySelector<HTMLElement>("#devis-erreur");
    const liste = document.querySelector<HTMLUListElement>("#devis-erreur-liste");
    const confirm = document.querySelector<HTMLElement>("#devis-confirm");
    const indice = document.querySelector<HTMLElement>("#devis-email-hint");

    // §3 : erreurs renvoyées par le serveur. `erreur=1` reste compris : c'est ce
    // que produit un corps de requête illisible, et d'anciens liens en circulent.
    const params = new URLSearchParams(location.search);
    // LOT DEVIS-5 : l'affichage de l'encart dépend du paramètre d'URL, plus de
    // l'état du POST, qui ne survivait pas à la navigation.
    const envoye = params.get("devis") === "ok";
    const codes = (params.get("erreur") || "")
      .split(",").map((c) => c.trim()).filter(Boolean);
    if (codes.length > 0 && bloc && liste) {
      const connus = codes.filter((c) => c in MESSAGES);
      const aAfficher = connus.length > 0 ? connus.map((c) => MESSAGES[c]) : [GENERIQUE];
      for (const texte of aAfficher) {
        const li = document.createElement("li");
        li.textContent = texte;
        liste.appendChild(li);
      }
      bloc.hidden = false;
      for (const code of connus) {
        const champ = devis.querySelector<HTMLElement>(`[name="${CHAMPS[code]}"]`);
        champ?.setAttribute("aria-invalid", "true");
      }
      const premier = devis.querySelector<HTMLElement>(`[aria-invalid="true"]`);
      premier?.focus();
    } else if (envoye || (confirm && demandeEnvoyee())) {
      // §2 : retour sur la page après un envoi, on ne redemande rien, on ramène
      // au créneau.
      // LOT DEVIS-5 : le `scrollIntoView` de DEVIS-4 est SUPPRIMÉ. Il entrait
      // en concurrence avec le positionnement natif sur l'ancre, et il perdait
      // de toute façon : la page était repositionnée en haut par le
      // chargement. C'est désormais le navigateur seul qui se place, à partir
      // du fragment `#devis-confirm` porté par la redirection. On ne garde pas
      // les deux mécanismes.
      confirm?.classList.add("est-visible");
      if (envoye) memoriser();
    }

    // §4 : conseil sur l'adresse, sans jamais empêcher l'envoi.
    if (emailInput && indice) {
      const jugerAdresse = () => {
        const domaine = (emailInput.value.split("@")[1] || "").toLowerCase().split(".")[0];
        indice.hidden = !(domaine && GRAND_PUBLIC.includes(domaine));
      };
      emailInput.addEventListener("input", jugerAdresse);
      emailInput.addEventListener("blur", jugerAdresse);
    }

    // LOT DEVIS-4 §3 : le pas du compteur. La saisie libre reste maitresse,
    // les boutons ne font que l'incrementer. Bornes 1 et 999999, les memes que
    // celles que le serveur accepte : on n'affiche jamais une valeur qu'il
    // refuserait ensuite.
    const champEtab = document.querySelector<HTMLInputElement>("#devis-etab");
    if (champEtab) {
      const pas = (delta: number) => {
        const actuel = parseInt(champEtab.value, 10);
        const depart = Number.isFinite(actuel) ? actuel : 0;
        champEtab.value = String(Math.min(999999, Math.max(1, depart + delta)));
        champEtab.dispatchEvent(new Event("input", { bubbles: true }));
      };
      document.querySelector<HTMLButtonElement>("#devis-moins")?.addEventListener("click", () => pas(-1));
      document.querySelector<HTMLButtonElement>("#devis-plus")?.addEventListener("click", () => pas(1));
      // Les fleches haut/bas existaient sur le champ `number` natif : on ne
      // retire pas un geste au clavier en changeant l'apparence du controle.
      champEtab.addEventListener("keydown", (e) => {
        if (e.key !== "ArrowUp" && e.key !== "ArrowDown") return;
        e.preventDefault();
        pas(e.key === "ArrowUp" ? 1 : -1);
      });
      // Un collage ou une saisie parasite ne laisse pas de non-chiffres.
      champEtab.addEventListener("input", () => {
        const propre = champEtab.value.replace(/\D/g, "").slice(0, 6);
        if (propre !== champEtab.value) champEtab.value = propre;
      });
    }

    document.querySelector<HTMLButtonElement>("#devis-redo")?.addEventListener("click", () => {
      try { localStorage.removeItem(DEVIS_KEY); } catch { /* rien à nettoyer */ }
      // `hidden` ne suffit plus : tant que l'URL porte le fragment, `:target`
      // rendrait l'encart de nouveau visible. On le masque donc par une classe
      // qui l'emporte sur les deux règles d'affichage.
      confirm?.classList.remove("est-visible");
      confirm?.classList.add("est-masque");
      devis.querySelector<HTMLInputElement>('input[name="name"]')?.focus();
    });

    devis.addEventListener("submit", () => {
      const hp = devis.querySelector<HTMLInputElement>('input[name="website"]');
      if (hp && hp.value.trim()) return;
      trackWithEmailHash("demande_devis", emailHash, { transport_type: "beacon" });
      // §1/§2 : l'état visible et la mémorisation partent AVANT la navigation.
      // Le bouton n'a pas d'attribut `name` : le désactiver ne retire aucune
      // donnée de la soumission déjà déclenchée.
      memoriser();
      if (statut) statut.hidden = false;
      const libelle = bouton?.textContent ?? "";
      if (bouton) {
        bouton.disabled = true;
        bouton.textContent = "Envoi en cours…";
      }

      // CORRECTIF DEVIS-1b : un état d'envoi qui ne se termine jamais est PIRE
      // que pas d'état du tout. C'est exactement ce qui s'est produit en
      // production : la CSP bloquait la redirection, la page ne bougeait plus,
      // et le bouton restait figé sur « Envoi en cours… » indéfiniment.
      //
      // Au-delà du délai, on rend la main : bouton réactivé, message franc (la
      // demande EST partie, c'est l'ouverture du calendrier qui a échoué) et
      // lien manuel. Ce filet ne dépend d'aucune hypothèse sur la cause : il
      // couvre aussi bien une CSP, une coupure réseau qu'un serveur muet.
      const secours = document.querySelector<HTMLElement>("#devis-secours");
      window.setTimeout(() => {
        if (document.visibilityState === "hidden") return; // page déjà quittée
        if (statut) statut.hidden = true;
        if (secours) secours.hidden = false;
        if (bouton) {
          bouton.disabled = false;
          bouton.textContent = libelle;
        }
      }, 6000);
    });
  }
</script>

