---
// Page de confirmation d'essai (GADS-1). Le fondateur pose cette URL en
// redirection de succès sur les 4 Payment Links Stripe : elle est donc atteinte
// juste après le paiement, ce qui en fait le point de mesure de l'événement de
// conversion `essai_demarre`. Page de service : noindex + hors sitemap
// (filtre dans astro.config.mjs), aucun bloc de closing.
import Base from "../layouts/Base.astro";
import { SITE, TRIAL_DAYS } from "../config/site";
---
<Base
  title="Votre essai démarre | Stela"
  description="Votre essai Stela est lancé. Vérifiez votre email pour votre première connexion."
  path="/merci-essai"
  noindex={true}
  closing={false}
>
  {/* LOT PRIX-1 : cette page sert AUSSI le retour du lien Polaire, qui y
      arrive avec `&polaire=1`. Or Polaire n'a pas d'essai : afficher « votre
      essai démarre » à quelqu'un qui vient de payer 139 € pour un
      accompagnement serait faux dès la première phrase.

      LE CHOIX SE FAIT CÔTÉ CLIENT, dans le script groupé en bas de page. La
      page est PRÉRENDUE : `Astro.url.searchParams` y est vide au build.

      ET PAS EN SCRIPT INLINE, bien qu'un inline aurait supprimé tout risque de
      clignotement : la CSP du site vaut `script-src 'self' …`, sans
      `'unsafe-inline'`. Un script inline serait REFUSÉ PAR LE NAVIGATEUR, en
      silence et sans erreur visible sur la page : la bascule ne se ferait
      jamais, et le client Polaire lirait « votre essai démarre ». C'est
      `check:cookies` qui l'a vu, pas la relecture.

      Le script groupé est un module, donc différé mais exécuté avant
      `DOMContentLoaded` : sur une page statique de cette taille, la bascule a
      lieu avant que l'œil ne s'y pose. Le défaut reste la variante ESSAI, qui
      est le cas de la grande majorité des visiteurs, et l'absence de
      JavaScript la laisse en place. */}
  <section>
    <div class="container" style="max-width:620px; text-align:center; padding-block:5rem;">
      <p class="eyebrow">Bienvenue</p>

      <div class="var-essai">
        <h1>Votre essai démarre, vérifiez votre email</h1>
        <p class="lead">
          Votre essai gratuit de {TRIAL_DAYS} jours est lancé. Nous venons de vous envoyer votre
          email de première connexion : il arrive dans quelques instants et contient le lien pour
          créer votre mot de passe et configurer votre établissement.
        </p>
      </div>

      <div class="var-polaire">
        <h1>Bienvenue. Corentin vous appelle sous 48 h</h1>
        <p class="lead">
          Corentin vous appelle sous 48 heures pour configurer votre établissement : votre fiche
          Google, vos QR codes, vos canaux de collecte et vos voisins. Vous n&apos;avez rien à
          préparer. Votre email de première connexion arrive dans quelques instants, pour que vous
          puissiez déjà regarder.
        </p>
      </div>
      <p style="color:var(--text-muted); font-size:.9rem;">
        Rien reçu après quelques minutes ? Pensez à vérifier vos spams, ou écrivez-nous à
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>, nous débloquons votre accès.
      </p>
      <p style="margin-top:2rem;">
        <a class="btn btn-primary" href={SITE.appUrl} rel="noopener">Accéder à mon espace Stela</a>
      </p>
    </div>
  </section>
</Base>

<style is:global>
  /* Une seule variante visible. `est-polaire` est posée par le script inline
     ci-dessus, donc avant le premier rendu : aucun clignotement. Sans
     JavaScript, la classe est absente et c'est la variante essai qui reste. */
  .var-polaire { display: none; }
  html.est-polaire .var-essai { display: none; }
  html.est-polaire .var-polaire { display: block; }
</style>

<script>
  // LOT PRIX-1 : bascule Polaire. Voir le commentaire au-dessus du corps de
  // page pour la raison du script GROUPÉ plutôt qu'inline (CSP sans
  // `unsafe-inline` : un inline serait refusé en silence).
  try {
    if (new URLSearchParams(location.search).get("polaire") === "1") {
      document.documentElement.classList.add("est-polaire");
      document.title = "Bienvenue chez Polaire | Stela";
    }
  } catch { /* URL illisible : on reste sur la variante essai */ }

  // Conversion `essai_demarre` au chargement. `track` n'émet RIEN sans
  // consentement : l'événement attend en file, et part si le visiteur accepte.
  //
  // LOT GADS-2, suivi avancé. L'email est saisi chez Stripe, pas ici : on le
  // demande à /api/checkout-email, qui lit la session Checkout et ne renvoie que
  // l'EMPREINTE SHA-256 (jamais l'email en clair, qui ne traverse donc jamais le
  // réseau). Sans ?session_id, sans clé Stripe configurée, ou si l'appel échoue,
  // l'événement part SANS empreinte, c'est exactement le comportement GADS-1.
  //
  // L'événement est émis une fois et une seule, quel que soit le chemin. Il n'est
  // pas retardé côté mesure : `track` empile dans la file tant que le
  // consentement n'est pas donné, et la bannière la vide à l'acceptation.
  // Chaque conversion dit POURQUOI elle part avec ou sans empreinte, via le
  // paramètre `ec_statut`. Sans ça, une conversion sans empreinte est
  // indiscernable d'un suivi avancé qui sous-performe : on accuserait le
  // dispositif alors que la cause serait un simple délai de l'API Stripe.
  // Le paramètre est volontairement à faible cardinalité (5 valeurs fixes) et ne
  // contient aucune donnée personnelle, il se segmente directement dans GA4.
  //   ok           : empreinte obtenue, suivi avancé nominal
  //   timeout      : /api/checkout-email n'a pas répondu en 4 s
  //   sans_session : pas de ?session_id (success_url Stripe non configurée)
  //   api_vide     : l'API a répondu sans empreinte (clé absente, session non
  //                  aboutie, email illisible)
  //   erreur       : appel en échec (réseau, 5xx)
  // Une remontée de `timeout` ou `sans_session` est un problème de configuration,
  // pas un problème de suivi avancé.
  import { trackWithEmailHash, isEmailHash } from "../lib/track";

  type Statut = "ok" | "timeout" | "sans_session" | "api_vide" | "erreur";
  const sessionId = new URLSearchParams(location.search).get("session_id");

  function emettre(hash: string | null, statut: Statut) {
    if (statut !== "ok") {
      // Trace locale, en complément du paramètre : utile en préproduction et
      // dans la console d'un visiteur qu'on dépanne.
      console.warn(`[GADS-2] essai_demarre part sans empreinte (${statut}).`);
    }
    trackWithEmailHash("essai_demarre", hash, { ec_statut: statut });
  }

  if (!sessionId) {
    emettre(null, "sans_session");
  } else {
    let fait = false;
    function once(hash: string | null, statut: Statut) {
      if (fait) return;
      fait = true;
      clearTimeout(secours);
      emettre(hash, statut);
    }
    // Garde-fou : si l'API traîne, on n'attend pas indéfiniment, la conversion
    // part sans empreinte plutôt que de ne pas partir du tout. Le `timeout` est
    // signalé, jamais avalé en silence.
    const secours = setTimeout(() => { once(null, "timeout"); }, 4000);
    fetch(`/api/checkout-email?session_id=${encodeURIComponent(sessionId)}`, { credentials: "omit" })
      .then((r) => {
        // ATTENTION : `fetch` ne rejette que sur panne réseau, JAMAIS sur un
        // statut 4xx/5xx. Sans ce tri, une API en erreur serveur serait
        // comptabilisée « api_vide », c'est-à-dire confondue avec le cas normal
        // où Stripe n'a simplement pas d'email. On distingue donc ici.
        if (!r.ok) throw new Error(String(r.status));
        return r.json();
      })
      .then((d) => (d && isEmailHash(d.h) ? once(d.h, "ok") : once(null, "api_vide")))
      .catch(() => once(null, "erreur"));
  }
</script>
