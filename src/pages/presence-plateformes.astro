---
import Base from "../layouts/Base.astro";
import { SITE , TARIFS_URL } from "../config/site";

// Page PRÉPARÉE mais non indexée (noindex + hors sitemap). À publier (retirer le
// noindex) quand la gestion de présence multi-plateformes sera disponible.
// Angle : être visible partout, y compris dans les réponses des IA (ChatGPT
// s'appuie notamment sur l'index Bing).
const platforms = [
  "Google Business Profile", "Bing Places", "Apple Plans", "TripAdvisor",
  "TheFork", "Yelp", "Pages Jaunes", "Facebook", "Instagram", "Waze",
  "Foursquare", "Petit Futé", "Tripadvisor Experiences", "Doctolib",
  "Planity", "Booking", "OpenTable", "Resy", "Uber Eats", "Deliveroo",
  "Just Eat", "Michelin",
];
---
<Base
  title="Présence sur 20+ plateformes | Stela"
  description="Gérez votre présence sur plus de 20 plateformes depuis Stela, et restez visible partout, y compris dans les réponses des intelligences artificielles."
  path="/presence-plateformes"
  noindex={true}
>
  <section class="hero">
    <div class="container" style="max-width:820px;">
      <p class="eyebrow">Bientôt disponible</p>
      <h1>Une présence cohérente sur plus de 20 plateformes</h1>
      <p class="lead">
        Vos informations à jour partout, au même endroit. Des annuaires locaux aux plateformes de votre secteur, et jusque dans les réponses des intelligences artificielles.
      </p>
      <div class="hero-cta">
        <a class="btn btn-primary" href={TARIFS_URL}>Essayer gratuitement</a>
      </div>
    </div>
  </section>

  <section>
    <div class="container" style="max-width:820px;">
      <h2>Visible aussi dans ChatGPT, via Bing</h2>
      <p>
        Quand un client demande conseil à une intelligence artificielle, celle-ci s'appuie sur des sources publiques. ChatGPT interroge notamment l'index de Bing : une présence exacte et cohérente sur ces plateformes augmente vos chances d'être cité. Gérer sa présence, ce n'est plus seulement remplir des annuaires, c'est nourrir les moteurs qui recommandent.
      </p>

      <h2>Plus de 20 plateformes couvertes</h2>
      <ul class="platform-grid">
        {platforms.map((p) => <li>{p}</li>)}
      </ul>
      <p class="note">La liste exacte des plateformes disponibles dépend de votre secteur et évolue régulièrement.</p>
    </div>
  </section>

  <section class="cta-final">
    <div class="container">
      <h2>Une présence maîtrisée, partout</h2>
      <a class="btn btn-primary" href={TARIFS_URL}>Essayer gratuitement</a>
    </div>
  </section>
</Base>

<style>
  .hero { background: linear-gradient(180deg, #fff 0%, var(--cream) 100%); }
  .hero-cta { margin-top: 1.5rem; }
  .platform-grid { list-style: none; padding: 0; margin: 1.5rem 0 1rem; display: grid;
    grid-template-columns: repeat(3, 1fr); gap: .6rem; }
  @media (max-width: 640px) { .platform-grid { grid-template-columns: repeat(2, 1fr); } }
  .platform-grid li { background: var(--surface); border: 1px solid var(--border); border-radius: 10px;
    padding: .6rem .8rem; font-weight: 600; font-size: .9rem; color: var(--ink); }
  .note { font-size: .82rem; color: var(--text-muted); }
  .cta-final { background: var(--ink); text-align: center; }
  .cta-final h2 { color: #fff; margin-bottom: 1.5rem; }
</style>
