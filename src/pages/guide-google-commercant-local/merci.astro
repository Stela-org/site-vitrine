---
import Base from "../../layouts/Base.astro";
import { TARIFS_URL } from "../../config/site";
---
<Base
  title="Votre guide arrive | Stela"
  description="Votre guide Google du commerçant local vous a été envoyé par email."
  path="/guide-google-commercant-local/merci"
  noindex={true}
  closing={false}
>
  <section>
    <div class="container" style="max-width:620px; text-align:center; padding-block:5rem;">
      <p class="eyebrow">Merci</p>
      <h1>Votre guide est en route</h1>
      <p class="lead">Nous venons de vous envoyer « Le guide Google du commerçant local » par email. Il arrive dans quelques instants, bonne lecture !</p>
      <p style="color:var(--text-muted); font-size:.9rem;">Rien reçu après quelques minutes ? Pensez à vérifier vos spams, ou réessayez depuis la <a href="/guide-google-commercant-local">page du guide</a>.</p>
      <p style="margin-top:2rem;"><a class="btn btn-primary" href={TARIFS_URL}>Essayer Stela, 7 jours gratuits</a></p>
    </div>
  </section>
</Base>

<script>
  // Conversion `guide_telecharge` au chargement de la page de confirmation du
  // lead magnet. Sans consentement, rien n'est émis : l'événement attend en file.
  import { track } from "../../lib/track";
  track("guide_telecharge");
</script>
