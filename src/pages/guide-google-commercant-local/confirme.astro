---
import Base from "../../layouts/Base.astro";
import { TARIFS_URL } from "../../config/site";
---
<Base
  title="C'est confirmé | Stela"
  description="Votre inscription est confirmée : votre guide arrive par email."
  path="/guide-google-commercant-local/confirme"
  noindex={true}
>
  <section>
    <div class="container" style="max-width:620px; text-align:center; padding-block:5rem;">
      <p class="eyebrow">Merci</p>
      <h1>C'est confirmé, votre guide arrive</h1>
      <p class="lead">Nous venons de vous envoyer « Le guide Google du commerçant local » par email. Bonne lecture !</p>
      <p style="margin-top:2rem;"><a class="btn btn-primary" href={TARIFS_URL}>Essayer Stela gratuitement</a></p>
    </div>
  </section>
</Base>
