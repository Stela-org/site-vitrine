---
import Base from "../layouts/Base.astro";
import { SITE, PLANS, stripeLink, PRODUCT_VIDEOS } from "../config/site";
import ProductVideo from "../components/ProductVideo.astro";
import { FEATURES } from "../content/features";
import { SEGMENTS } from "../content/segments";
import { STORIES } from "../content/stories";
import PhoneReview from "../components/PhoneReview.astro";
import ReviewCard from "../components/ReviewCard.astro";
import FeatureVisual from "../components/FeatureVisual.astro";
import ROICard from "../components/ROICard.astro";
import LogoWall from "../components/LogoWall.astro";
import TripleZero from "../components/TripleZero.astro";
import Integrations from "../components/Integrations.astro";
import Glyph from "../components/Glyph.astro";

// VIT-12 §3 : bandeau « Ils nous font confiance » (partenaires). Plateformes
// de visibilité + caisses partenaires (Square, Zelty). Libellés courts pour le
// mur de logos ; ceux sans logo simple-icons tombent sur un wordmark (LogoWall),
// exactement comme la section Intégrations qui les liste déjà en toutes lettres.
const coveragePlatforms = [
  "Google", "Google Maps", "TripAdvisor", "TheFork", "Bing",
  "ChatGPT", "Gemini", "Microsoft Copilot", "Waze", "Perplexity",
  "Square", "Zelty",
] as const;

// Plateformes d'avis réunies dans « Avis publics » (offre multi-plateformes).
const reviewPlatforms = ["Google", "TripAdvisor", "TheFork", "Pages Jaunes", "Yelp"] as const;

// Cartes d'avis ILLUSTRATIVES (anonymisées, exemples de fonctionnement, pas de
// vrais clients ni de faux chiffres).
// VIT-15 §3 : exemples répartis sur 4 métiers (coiffeur, restaurant, hôtel,
// garage), pas 100 % resto. Plateforme cohérente avec le métier (TheFork =
// restaurant, TripAdvisor = hôtel/resto, Google = partout). Réponses neutres.
const demoReviews = [
  { initial: "L.", name: "Léa M.", platform: "google" as const, meta: "Avis Google · il y a 2 jours", text: "Coupe et couleur parfaites, on ressort avec le sourire. Salon impeccable.", reply: "Merci Léa ! Ravis que le résultat vous plaise, toute l'équipe du salon vous dit à bientôt.", featured: true },
  { initial: "K.", name: "Karim B.", platform: "thefork" as const, meta: "Avis TheFork · il y a 5 jours", text: "Réservation en deux clics, table prête à l'heure et service attentionné.", reply: "Merci Karim, ravis que la réservation ait été simple. La terrasse vous attend dès les beaux jours." },
  { initial: "S.", name: "Sophie D.", platform: "tripadvisor" as const, meta: "Avis TripAdvisor · il y a 1 semaine", text: "Chambre au calme, lit très confortable et accueil aux petits soins. On reviendra.", reply: "Un grand merci Sophie, ravis que votre séjour vous ait plu. Au plaisir de vous accueillir à nouveau." },
  { initial: "T.", name: "Thomas R.", platform: "google" as const, meta: "Avis Google · il y a 3 jours", text: "Diagnostic clair, réparation rapide et tarif honnête. Je recommande ce garage.", reply: "Merci Thomas ! Ravis d'avoir remis votre véhicule en route, bonne route à vous." },
];

// Maillage : les cartes de la home pointent vers les pages fonctionnalités
// dédiées (source unique content/features.ts). VIT-10 : ordonnées selon le
// parcours client A→Z (avant la visite → après → au fil du temps → fidélisation)
// pour montrer que Stela couvre tout le trajet. L'ordre est LOCAL à la home (on
// ne réordonne pas la source FEATURES, qui pilote d'autres pages).
const JOURNEY = [
  { slug: "avis-multi-plateformes", stage: "Avant la visite" },
  { slug: "centralisation-reservations", stage: "Avant la visite" },
  { slug: "collecte-avis-google", stage: "Après la visite" },
  { slug: "reponse-automatique-avis", stage: "Après la visite" },
  { slug: "analyse-des-avis", stage: "Au fil du temps" },
  { slug: "sms-fidelisation", stage: "Fidélisation" },
] as const;
// VIT-14 §7 : maillage vers les pages métier (/pour/[slug]). Secteurs d'abord
// (Restaurant, Coiffeur, Institut, Garage), puis profils (Indépendants,
// Multi-établissements). Une carte par segment existant, source content/segments.
const SEGMENT_KIND_ORDER = { secteur: 0, profil: 1 } as const;
const segmentLinks = [...SEGMENTS]
  .sort((a, b) => SEGMENT_KIND_ORDER[a.kind] - SEGMENT_KIND_ORDER[b.kind])
  .map((s) => ({ slug: s.slug, label: s.navLabel, icon: s.icon, tagline: s.tagline }));

const bySlug = new Map(FEATURES.map((f) => [f.slug, f]));
const features = JOURNEY.flatMap((j) => {
  const f = bySlug.get(j.slug);
  return f ? [{ slug: f.slug, t: f.navLabel, d: f.benefits[0].d, stage: j.stage }] : [];
});

const faq = [
  {
    q: "Que se passe-t-il quand un client est déçu ?",
    a: "Il vous le dit en privé d'abord, grâce à un canal privé. Vous le rattrapez avant que ça devienne public, et souvent il revient. Si l'avis est tout de même publié, Nova vous aide à y répondre calmement. Vos avis publics, eux, restent toujours libres et jamais filtrés.",
  },
  {
    q: "Est-ce conforme aux règles de Google ?",
    a: "Oui, à 100 %, et c'est justement ce qui protège votre fiche. Stela n'utilise aucun filtrage interdit : votre établissement ne risque pas de sanction, et vous gagnez durablement en visibilité, sur Google comme dans les réponses des IA.",
  },
  {
    q: "Combien coûte Stela ?",
    a: "Deux offres transparentes : Étoile à 49 € par mois et Constellation à 89 € par mois. En annuel, 468 € et 948 € par an, soit 120 € d'économie. Essai gratuit de 7 jours, sans engagement, annulable en un clic.",
  },
  {
    q: "Pour quels commerces ?",
    a: "Tous les commerces locaux : restaurants, coiffeurs, instituts, garages, hôtels, santé. Le paramétrage s'adapte à votre secteur.",
  },
  {
    q: "Comment commencer ?",
    a: "Vous choisissez votre offre ici et vous réglez en ligne (essai gratuit de 7 jours, sans engagement, annulable en un clic). Vous recevez aussitôt votre email de première connexion pour brancher votre fiche Google. Aucune démonstration obligatoire.",
  },
];

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const websiteLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: SITE.brand,
  url: SITE.url,
  inLanguage: "fr-FR",
  publisher: { "@type": "Organization", name: SITE.brand },
};
---

<Base
  title="Stela | Avis Google et croissance des commerces locaux"
  description="Collecte d'avis Google 100 % conforme, réponses IA, réservation et fidélisation pour tous les commerces locaux. Prix transparents, essai gratuit."
  path="/"
>
  <script type="application/ld+json" set:html={JSON.stringify(websiteLd)} is:inline />
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} is:inline />

  {/* HERO */}
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">Votre réputation locale, en pilote automatique</p>
        <h1>Plus d'avis Google, des réponses toutes prêtes, des clients qui reviennent.</h1>
        <p class="lead">
          Stela collecte vos avis, y répond avec Nova en 10 secondes et fait revenir vos clients. Vous gardez la main, et vous êtes prêt en 10 minutes.
        </p>
        <div class="hero-cta">
          <a class="btn btn-primary" href="#tarifs">Essai gratuit 7 jours</a>
          <a class="btn btn-ghost" href="#tarifs">Voir les tarifs</a>
        </div>
        <div class="hero-trust"><TripleZero /></div>
      </div>
      <div class="hero-visual">
        <PhoneReview />
        <div class="hero-review"><ReviewCard {...demoReviews[0]} /></div>
      </div>
    </div>
  </section>

  {/* DÉFINITION EXTRACTIBLE (LOT SEO-GEO-1 §A1)
      Le site n'avait, nulle part dans son HTML, de phrase « Stela est un… ».
      Elle ne vivait que dans llms.txt, que les moteurs de réponse ne lisent pas
      tous : un modèle qui citait cette page n'avait aucune définition à
      reprendre et devait en fabriquer une. Elle est désormais en HTML réel,
      lisible par un humain, juste sous le hero, et rendue depuis
      `SITE.definition`, la même chaîne que le JSON-LD et llms.txt.
      Volontairement sobre : ce bloc ne vend rien, le hero au-dessus s'en
      charge. Une phrase écrite pour vendre ne se cite pas. */}
  <section class="definition">
    <div class="container">
      <p class="definition-text">{SITE.definition}</p>
    </div>
  </section>

  {/* AIGUILLAGE MÉTIER (VIT-15 §2) : juste sous le hero. La home est générique,
      chacun clique SUR SA page métier. Cartes visuelles vers /pour/[slug]. */}
  <section class="segments">
    <div class="container">
      <p class="eyebrow">Stela pour votre métier</p>
      <h2>Vous tenez un commerce ? Il y a une page pour vous.</h2>
      <p class="section-lead">Restaurant, salon, institut, garage, hôtel ou plusieurs adresses : Stela arrive pré-réglé pour votre activité. Choisissez la vôtre.</p>
      <div class="segments-grid">
        {segmentLinks.map((s) => (
          <a class="segment-card" href={`/pour/${s.slug}`}>
            <span class="segment-ic" aria-hidden="true">{s.icon}</span>
            <span class="segment-body">
              <span class="segment-label">{s.label}</span>
              <span class="segment-tag">{s.tagline}</span>
            </span>
            <span class="segment-arrow" aria-hidden="true">&rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* PARTENAIRES : bandeau « Ils font partie de la constellation Stela »
      (VIT-13 §2, univers étoilé + offre Constellation). Grille statique élégante
      (VIT-11 §2), tailles/espacements unifiés par LogoWall, fond encre. */}
  <section class="coverage">
    <div class="container">
      <p class="coverage-lead">Ils font partie de la constellation Stela</p>
      <LogoWall items={coveragePlatforms} tone="dark" marquee={false} />
    </div>
  </section>

  {/* PREUVE SOCIALE VISIBLE : cartes d'avis illustratives, honnêtes */}
  <section class="reviews">
    <div class="container">
      <p class="eyebrow">Voici ce que ça donne</p>
      <h2>Des avis qui arrivent, des réponses déjà prêtes</h2>
      <p class="reviews-note">Nova, votre assistante, écrit la réponse en 10 secondes, et chaque réponse renforce votre visibilité en ligne, sur Google comme sur les autres plateformes. Vous relisez, vous envoyez. Exemples illustratifs, avis anonymisés.</p>
      <div class="reviews-band reveal-stagger">
        {demoReviews.map((r) => <ReviewCard {...r} />)}
      </div>
      {/* VIT-10 : la collecte ne se limite pas à Google. Strip des plateformes
          d'avis réunies au même endroit (offre multi-plateformes). */}
      <p class="reviews-plats-title">Pas seulement Google : vos avis réunis au même endroit</p>
      <LogoWall items={reviewPlatforms} tone="light" marquee={false} />
    </div>
  </section>

  {/* EMPLACEMENT VIDÉO (rendu uniquement si un clip est configuré) */}
  {PRODUCT_VIDEOS.home && (
    <section class="demo-video">
      <div class="container" style="text-align:center;">
        <p class="eyebrow">Stela en action</p>
        <h2>Voyez comme c'est simple</h2>
        <div class="demo-video-frame">
          <ProductVideo {...PRODUCT_VIDEOS.home} eager={false} radius="18px" />
        </div>
      </div>
    </section>
  )}

  {/* FONCTIONNALITÉS */}
  <section id="fonctionnalites">
    <div class="container">
      <p class="eyebrow">Ce que fait Stela</p>
      <h2>Tout pour votre réputation locale, au même endroit</h2>
      <p class="section-lead">De la première recherche d'un client jusqu'à son retour : Stela vous accompagne à chaque étape.</p>
      <div class="grid-3 reveal-stagger feature-grid">
        {features.map((f) => (
          <a class="card feature-card" href={`/${f.slug}`}>
            {/* VIT-18 : étoile laiton en tête de carte. SVG inline via Glyph
                (JAMAIS le caractère U+2733, rendu emoji vert sur iOS).
                Décoratif : le contenu de la carte est inchangé. */}
            <span class="feature-glyph"><Glyph size="1em" /></span>
            {/* VIT-18 : liseré laiton qui se trace au survol (desktop seul).
                Purement décoratif, aria-hidden, aucune requête ajoutée. */}
            <svg class="feature-rule" viewBox="0 0 100 2" preserveAspectRatio="none" aria-hidden="true" focusable="false">
              <line x1="0" y1="1" x2="100" y2="1" />
            </svg>
            <FeatureVisual slug={f.slug} />
            <span class="feature-stage">{f.stage}</span>
            <h3>{f.t}</h3>
            <p>{f.d}</p>
            <span class="feature-more">Découvrir</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* INTÉGRATIONS : où Stela vous rend visible (livré vs bientôt) */}
  <Integrations />

  {/* PILIER PRIVÉ D'ABORD : rupture de style (fond encre, mot laiton géant).
      Von Restorff de la home. On dose « zéro filtrage » (devenu une preuve parmi
      d'autres) et on met en avant le vrai réflexe conforme : le canal privé. */}
  <section id="conformite" class="conformite">
    <div class="container conf-inner">
      <p class="conf-eyebrow">Le bon réflexe</p>
      <p class="conf-giant">En <span>privé</span>, d'abord.</p>
      <h2 class="conf-title">Un client déçu ? Il vous le dit en privé d'abord. Vous le rattrapez avant que ça devienne public.</h2>
      <p class="conf-lead">
        Avec Stela, un client mécontent peut vous écrire en privé. Vous corrigez, souvent il revient. Ses avis publics, eux, restent toujours libres et non filtrés : la règle de Google est aussi la nôtre.
      </p>
      <p class="conf-risk">
        Acheter des avis ou trier ses clients, Google l'interdit : votre fiche peut disparaître de la carte, et vous reculez dans Google comme dans les réponses des IA (ChatGPT, Gemini).
      </p>
      <ul class="conf-list">
        <li>Un canal privé pour rattraper un client déçu, en plus de l'avis public.</li>
        <li>Tous les avis publics restent libres, jamais filtrés selon la note.</li>
        <li>Conforme aux règles de Google et au RGPD.</li>
      </ul>
    </div>
  </section>

  {/* SUCCESS STORIES (structure prête ; chiffre réel en titre). Rendu seulement
      si des cas réels existent, sinon un état honnête « à venir ». */}
  <section class="stories">
    <div class="container">
      <p class="eyebrow">Résultats clients</p>
      <h2>Des chiffres réels, quand ils sont là</h2>
      {STORIES.length > 0 ? (
        <div class="grid-3 reveal-stagger">
          {STORIES.map((s) => (
            <div class="card story-card">
              <p class="story-metric">{s.metric}</p>
              <h3>{s.title}</h3>
              <p class="story-quote">« {s.quote} »</p>
              <p class="story-author">{s.author} · {s.sector}{s.city ? `, ${s.city}` : ""}</p>
            </div>
          ))}
        </div>
      ) : (
        <div class="results">
          <div class="results-stats reveal-stagger">
            <div class="stat">
              <p class="stat-num" data-count="94" data-suffix=" %">94 %</p>
              <p class="stat-label">des consommateurs lisent les avis en ligne avant de choisir un commerce local.</p>
              <p class="stat-src">Source : BrightLocal, Local Consumer Review Survey.</p>
            </div>
            <div class="stat">
              <p class="stat-num" data-count="-31" data-suffix=" %">-31 %</p>
              <p class="stat-label">de dépenses vers un commerce sous 4★ face à un concurrent à 4,5★.</p>
              <p class="stat-src">Source : Harvard Business School, étude M. Luca.</p>
            </div>
          </div>

          <div class="results-grid">
            <div class="card calc">
              <h3>Faites le calcul pour votre établissement</h3>
              <form class="calc-form" id="review-calc">
                <label class="calc-field">Clients par jour
                  <input type="number" name="clients" min="0" max="9999" value="40" inputmode="numeric" />
                </label>
                <label class="calc-field">Taux de participation estimé
                  <span class="calc-range"><input type="range" name="rate" min="1" max="30" value="8" /><output>8 %</output></span>
                </label>
              </form>
              <p class="calc-result">Entre <strong data-calc-low>48</strong> et <strong data-calc-high>86</strong> nouveaux avis par mois <span class="calc-tag">fourchette prudente</span></p>
              <p class="calc-note">Hypothèse volontairement prudente : clients par jour × 30 × taux de participation, avec une marge basse et haute. Indicatif, non contractuel.</p>
            </div>
            <div class="story-mock reveal"><ROICard /></div>
          </div>

          <p class="results-cred">L'équipe Stela a équipé plus de 170 restaurants avec la génération précédente de l'outil.</p>
          <div class="results-cta">
            <a class="btn btn-primary" href="#tarifs">Devenez l'une de nos étoiles montantes</a>
          </div>

          <script>
            // Progressive enhancement (bundlé, CSP 'self'). Sans JS : l'exemple
            // pré-rempli (40 clients, 15 %, ≈180) et les chiffres finaux restent
            // affichés. Le contenu n'est jamais masqué.
            const form = document.getElementById("review-calc") as HTMLFormElement | null;
            if (form) {
              const low = document.querySelector("[data-calc-low]");
              const high = document.querySelector("[data-calc-high]");
              const rangeOut = form.querySelector("output");
              const fr = (n: number) => Math.round(n).toLocaleString("fr-FR");
              const recompute = () => {
                const c = Number((form.elements.namedItem("clients") as HTMLInputElement).value) || 0;
                const r = Number((form.elements.namedItem("rate") as HTMLInputElement).value) || 0;
                if (rangeOut) rangeOut.textContent = r + " %";
                const base = c * 30 * (r / 100);
                // Fourchette prudente : borne basse à 50 %, borne haute à 90 % de
                // l'estimation théorique (on n'annonce jamais le maximum optimiste).
                if (low) low.textContent = fr(base * 0.5);
                if (high) high.textContent = fr(base * 0.9);
              };
              form.addEventListener("input", recompute);
              recompute();
            }
          </script>
        </div>
      )}
    </div>
  </section>

  {/* TARIFS (toggle mensuel/annuel, 100 % CSS, fonctionne sans JS) */}
  <section id="tarifs" class="tarifs">
    <div class="container">
      <p class="eyebrow">Tarifs transparents</p>
      <h2>Un prix affiché, un essai gratuit, sans engagement</h2>

      <div class="billing-toggle">
        <input type="checkbox" id="billing" class="billing-input" aria-label="Afficher les tarifs annuels (120 € d'économie par an)" />
        <label for="billing" class="billing-switch">
          <span class="opt opt-m">Mensuel</span>
          <span class="opt opt-y">Annuel <span class="save">-120 € par an</span></span>
        </label>
      </div>

      <div class="grid-plans reveal-stagger">
        {PLANS.map((p) => (
          <div class={`card plan${p.highlight ? " plan-hl" : ""}`}>
            {p.highlight && <span class="plan-badge">Le plus complet</span>}
            <h3 class="plan-name">{p.name}</h3>
            <p class="plan-tag">{p.tagline}</p>
            <p class="plan-price">
              <span class="amount amount-m">{p.monthly} €</span>
              <span class="amount amount-y">{p.yearlyPerMonth} €</span>
              <span class="per">/ mois</span>
            </p>
            <p class="plan-note plan-note-y">Soit {p.yearlyTotal} € par an, facturé en une fois (120 € d'économie).</p>
            {p.highlight && <p class="plan-wheel">🎁 Inclut la roue cadeau, 100 % conforme aux règles de Google.</p>}
            <ul class="check-list">
              {p.features.map((f) => <li>{f}</li>)}
            </ul>
            <a class={`btn ${p.highlight ? "btn-primary" : "btn-ghost"} plan-cta`} data-plan-cta
              data-href-monthly={stripeLink(p.id, "monthly", "home")}
              data-href-yearly={stripeLink(p.id, "yearly", "home")}
              href={stripeLink(p.id, "monthly", "home")}>Essai gratuit 7 jours</a>
          </div>
        ))}
      </div>
      <p class="tarifs-foot">Paiement sécurisé via Stripe. Essai gratuit de 7 jours, sans engagement, annulable en un clic.</p>
    </div>
  </section>

  {/* Q&A citable (aligné sur le schema FAQPage) */}
  <section class="faq">
    <div class="container">
      <p class="eyebrow">Questions fréquentes</p>
      <h2>Ce qu'il faut savoir</h2>
      <div class="faq-list reveal-stagger">
        {faq.map((f) => (
          <div class="faq-item">
            <h3>{f.q}</h3>
            <p>{f.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  /* Le hero garde sa respiration malgré la densité globale (VIT-9e). */
  .hero { background: linear-gradient(180deg, #fff 0%, var(--cream) 100%); padding-block: clamp(44px, 7vw, 92px); }
  .hero-grid { display: grid; grid-template-columns: 1.1fr .9fr; gap: 3rem; align-items: center; }
  .hero-cta { display: flex; gap: .75rem; flex-wrap: wrap; margin: 1.75rem 0 1rem; }
  .hero-trust { font-size: .9rem; color: var(--text-muted); margin: 0; }
  /* Cluster visuel du hero : téléphone + carte d'avis flottante. */
  .hero-visual { position: relative; min-height: 520px; display: flex; align-items: center; justify-content: center; }
  .hero-review { position: absolute; right: -12px; bottom: -18px; width: 244px; transform: rotate(3deg); z-index: 4; }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      /* transform seul : la carte n'est jamais masquée si l'animation échoue. */
      /* Longhands : le raccourci `animation` + `animation-timeline` est replié
         par le minifieur en une valeur illégale et la règle est jetée. */
      .hero-review { animation-name: float-up; animation-timing-function: linear;
        animation-fill-mode: both; animation-timeline: view(); animation-range: entry 0% cover 30%; }
    }
  }
  @keyframes float-up { from { transform: translateY(22px) rotate(3deg); } to { transform: rotate(3deg); } }
  @media (max-width: 980px) { .hero-review { width: 214px; right: -6px; } }
  @media (max-width: 820px) {
    .hero-grid { grid-template-columns: 1fr; }
    /* Superposition conservée mais DISCRÈTE : la carte est réduite (scale) et
       ancrée dans le coin bas-droite (transform-origin), donc elle ne couvre que
       ce coin du téléphone. Le titre, la roue-cadeau et les étoiles restent
       lisibles, et elle ne remonte pas sur la ligne de badges au-dessus.
       animation coupée sur mobile (sinon les keyframes float-up écrasent scale). */
    .hero-visual { min-height: 440px; margin-top: 1.5rem; }
    .hero-review { width: 244px; right: 0; bottom: 4px; transform-origin: bottom right;
      transform: scale(.6) rotate(3deg); animation: none; }
  }
  @media (max-width: 420px) {
    .hero-visual { min-height: 400px; }
    .hero-review { transform: scale(.52) rotate(3deg); bottom: 2px; }
  }

