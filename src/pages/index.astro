      .feature-grid > :nth-child(1) { animation-range: entry 0% cover 25%; }
      .feature-grid > :nth-child(2) { animation-range: entry 0% cover 31%; }
      .feature-grid > :nth-child(3) { animation-range: entry 0% cover 37%; }
      .feature-grid > :nth-child(4) { animation-range: entry 0% cover 43%; }
      .feature-grid > :nth-child(5) { animation-range: entry 0% cover 49%; }
      .feature-grid > :nth-child(6) { animation-range: entry 0% cover 55%; }
    }
  }

