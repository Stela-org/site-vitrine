---
import Base from "../layouts/Base.astro";
import { SITE, PLANS } from "../config/site";
import { FEATURES } from "../content/features";
import { STORIES } from "../content/stories";
import PhoneReview from "../components/PhoneReview.astro";
import ReviewCard from "../components/ReviewCard.astro";
import GiftWheelMini from "../components/GiftWheelMini.astro";
import MiniMockup from "../components/MiniMockup.astro";
import ROICard from "../components/ROICard.astro";

// Cartes d'avis ILLUSTRATIVES (anonymisées, exemples de fonctionnement, pas de
// vrais clients ni de faux chiffres).
const demoReviews = [
  { initial: "M.", name: "Marie L.", meta: "Avis Google · il y a 2 jours", text: "Accueil adorable et cuisine généreuse, on reviendra sans hésiter.", reply: "Merci Marie ! Ravis que notre cuisine du marché vous ait plu, à très vite dans le Marais.", featured: true },
  { initial: "K.", name: "Karim B.", meta: "Avis Google · il y a 5 jours", text: "Très bon moment, service attentionné et belle terrasse au calme.", reply: "Merci Karim, la terrasse vous attend dès les beaux jours. Au plaisir de vous revoir." },
  { initial: "S.", name: "Sophie D.", meta: "Avis Google · il y a 1 semaine", text: "Parfait pour un dîner en famille, les enfants ont adoré le dessert.", reply: "Un grand merci Sophie, on transmet le compliment au chef pâtissier !" },
];

// Maillage : les cartes de la home pointent vers les pages fonctionnalités
// dédiées (source unique content/features.ts).
const features = FEATURES.map((f) => ({ slug: f.slug, t: f.navLabel, d: f.benefits[0].d, mockup: f.mockup }));

const faq = [
  {
    q: "Stela filtre-t-il les avis négatifs ?",
    a: "Non. Stela invite tous vos clients à laisser un avis public sur Google, quelle que soit leur satisfaction. Filtrer les avis selon la note est contraire aux règles de Google : Stela ne le fait jamais.",
  },
  {
    q: "Combien coûte Stela ?",
    a: "Deux offres transparentes : Étoile à 49 € par mois et Constellation à 89 € par mois. L'abonnement annuel revient à deux mois offerts. L'essai est gratuit et sans engagement.",
  },
  {
    q: "Pour quels commerces ?",
    a: "Tous les commerces locaux : restaurants, coiffeurs, instituts, garages, hôtels, santé. Le paramétrage s'adapte à votre secteur.",
  },
  {
    q: "Comment commencer ?",
    a: "Vous créez votre compte sur l'application, vous connectez votre fiche Google et vous êtes prêt. Aucune démonstration obligatoire, aucune carte requise pour essayer.",
  },
];

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const websiteLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: SITE.brand,
  url: SITE.url,
  inLanguage: "fr-FR",
  publisher: { "@type": "Organization", name: SITE.brand },
};
---

<Base
  title="Stela | Le moteur de croissance Google conforme des commerces locaux"
  description="Collecte d'avis Google 100 % conforme, réponses IA, réservation et fidélisation pour tous les commerces locaux. Prix transparents, essai gratuit."
  path="/"
>
  <script type="application/ld+json" set:html={JSON.stringify(websiteLd)} is:inline />
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} is:inline />

  {/* HERO */}
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">100 % conforme aux règles de Google</p>
        <h1>{SITE.positioning}</h1>
        <p class="lead">
          Collectez plus d'avis, répondez automatiquement et faites revenir vos clients. Sans filtrer une seule note, parce que la conformité est notre force.
        </p>
        <div class="hero-cta">
          <a class="btn btn-primary" href={SITE.appUrl}>Essayer gratuitement</a>
          <a class="btn btn-ghost" href="#tarifs">Voir les tarifs</a>
        </div>
        <p class="hero-trust">Prix transparents. Essai sans engagement. Aucune carte requise.</p>
      </div>
      <div class="hero-visual">
        <PhoneReview />
        <div class="hero-review"><ReviewCard {...demoReviews[0]} /></div>
        <div class="hero-wheel"><GiftWheelMini /></div>
      </div>
    </div>
  </section>

  {/* PREUVE (bande neutre) */}
  <section class="proof">
    <div class="container">
      <p class="proof-line">Pensé pour tous les commerces locaux : restaurants, coiffeurs, instituts, garages, hôtels, santé.</p>
    </div>
  </section>

  {/* PREUVE SOCIALE VISIBLE : cartes d'avis illustratives, honnêtes */}
  <section class="reviews">
    <div class="container">
      <p class="eyebrow">Voici ce que ça donne</p>
      <h2>Des avis qui arrivent, des réponses déjà prêtes</h2>
      <p class="reviews-note">Exemples illustrant le fonctionnement de Stela. Avis anonymisés, réponses générées automatiquement.</p>
      <div class="reviews-band reveal-stagger">
        {demoReviews.map((r) => <ReviewCard {...r} />)}
      </div>
    </div>
  </section>

  {/* FONCTIONNALITÉS */}
  <section id="fonctionnalites">
    <div class="container">
      <p class="eyebrow">Ce que fait Stela</p>
      <h2>Tout pour votre réputation locale, au même endroit</h2>
      <div class="grid-3 reveal-stagger">
        {features.map((f) => (
          <a class="card feature-card" href={`/${f.slug}`}>
            <MiniMockup module={f.mockup.module} rows={f.mockup.rows} />
            <h3>{f.t}</h3>
            <p>{f.d}</p>
            <span class="feature-more">Découvrir</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* CONFORMITÉ : rupture totale de style (fond encre plein, chiffre laiton géant) */}
  <section id="conformite" class="conformite">
    <div class="container conf-inner">
      <p class="conf-eyebrow">Notre différence</p>
      <p class="conf-giant"><span>Zéro</span> filtrage.</p>
      <h2 class="conf-title">Tous les avis sont les bienvenus.</h2>
      <p class="conf-lead">
        Certains outils trient les clients et détournent les avis négatifs. C'est interdit par Google et met votre fiche en danger. Stela fait l'inverse : chaque client est invité à s'exprimer publiquement, et la récupération se fait en plus, jamais à la place.
      </p>
      <ul class="conf-list">
        <li>Aucun filtrage des avis selon la note.</li>
        <li>Aucune interception des clients insatisfaits.</li>
        <li>Conforme aux règles de Google et au RGPD.</li>
      </ul>
    </div>
  </section>

  {/* SUCCESS STORIES (structure prête ; chiffre réel en titre). Rendu seulement
      si des cas réels existent, sinon un état honnête « à venir ». */}
  <section class="stories">
    <div class="container">
      <p class="eyebrow">Résultats clients</p>
      <h2>Des chiffres réels, quand ils sont là</h2>
      {STORIES.length > 0 ? (
        <div class="grid-3 reveal-stagger">
          {STORIES.map((s) => (
            <div class="card story-card">
              <p class="story-metric">{s.metric}</p>
              <h3>{s.title}</h3>
              <p class="story-quote">« {s.quote} »</p>
              <p class="story-author">{s.author} · {s.sector}{s.city ? `, ${s.city}` : ""}</p>
            </div>
          ))}
        </div>
      ) : (
        <div class="results">
          <div class="results-stats reveal-stagger">
            <div class="stat">
              <p class="stat-num" data-count="94" data-suffix=" %">94 %</p>
              <p class="stat-label">des consommateurs lisent les avis en ligne avant de choisir un commerce local.</p>
              <p class="stat-src">Source : BrightLocal, Local Consumer Review Survey.</p>
            </div>
            <div class="stat">
              <p class="stat-num" data-count="-31" data-suffix=" %">-31 %</p>
              <p class="stat-label">de dépenses vers un commerce sous 4★ face à un concurrent à 4,5★.</p>
              <p class="stat-src">Source : Harvard Business School, étude M. Luca.</p>
            </div>
          </div>

          <div class="results-grid">
            <div class="card calc">
              <h3>Faites le calcul pour votre établissement</h3>
              <form class="calc-form" id="review-calc">
                <label class="calc-field">Clients par jour
                  <input type="number" name="clients" min="0" max="9999" value="40" inputmode="numeric" />
                </label>
                <label class="calc-field">Taux de participation
                  <span class="calc-range"><input type="range" name="rate" min="1" max="50" value="15" /><output>15 %</output></span>
                </label>
              </form>
              <p class="calc-result">≈ <strong data-calc-out>180</strong> avis par mois <span class="calc-tag">projection</span></p>
              <p class="calc-note">Estimation indicative : clients par jour × 30 × taux de participation. Non contractuelle.</p>
            </div>
            <div class="story-mock reveal"><ROICard /></div>
          </div>

          <p class="results-cred">L'équipe Stela a équipé plus de 170 restaurants avec la génération précédente de l'outil.</p>
          <div class="results-cta">
            <a class="btn btn-primary" href={SITE.appUrl}>Devenir l'un de nos premiers cas mesurés</a>
          </div>

          <script>
            // Progressive enhancement (bundlé, CSP 'self'). Sans JS : l'exemple
            // pré-rempli (40 clients, 15 %, ≈180) et les chiffres finaux restent
            // affichés. Le contenu n'est jamais masqué.
            const form = document.getElementById("review-calc") as HTMLFormElement | null;
            if (form) {
              const out = document.querySelector("[data-calc-out]");
              const rangeOut = form.querySelector("output");
              const recompute = () => {
                const c = Number((form.elements.namedItem("clients") as HTMLInputElement).value) || 0;
                const r = Number((form.elements.namedItem("rate") as HTMLInputElement).value) || 0;
                if (rangeOut) rangeOut.textContent = r + " %";
                if (out) out.textContent = Math.round(c * 30 * (r / 100)).toLocaleString("fr-FR");
              };
              form.addEventListener("input", recompute);
              recompute();
            }
            const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
            const nums = document.querySelectorAll<HTMLElement>(".stat-num[data-count]");
            if (nums.length && !reduce && "IntersectionObserver" in window) {
              const io = new IntersectionObserver((entries, obs) => {
                for (const e of entries) {
                  if (!e.isIntersecting) continue;
                  obs.unobserve(e.target);
                  const el = e.target as HTMLElement;
                  const target = parseFloat(el.dataset.count || "0");
                  const suffix = el.dataset.suffix || "";
                  const sign = target < 0 ? "-" : "";
                  const abs = Math.abs(target);
                  const dur = 900; let start = 0;
                  const tick = (t: number) => {
                    if (!start) start = t;
                    const p = Math.min((t - start) / dur, 1);
                    el.textContent = sign + Math.round(abs * p) + suffix;
                    if (p < 1) requestAnimationFrame(tick); else el.textContent = sign + abs + suffix;
                  };
                  requestAnimationFrame(tick);
                }
              }, { threshold: 0.4 });
              nums.forEach((n) => io.observe(n));
            }
          </script>
        </div>
      )}
    </div>
  </section>

  {/* TARIFS (toggle mensuel/annuel, 100 % CSS, fonctionne sans JS) */}
  <section id="tarifs" class="tarifs">
    <div class="container">
      <p class="eyebrow">Tarifs transparents</p>
      <h2>Un prix affiché, un essai gratuit, sans engagement</h2>

      <div class="billing-toggle">
        <input type="checkbox" id="billing" class="billing-input" aria-label="Afficher les tarifs annuels (2 mois offerts)" />
        <label for="billing" class="billing-switch">
          <span class="opt opt-m">Mensuel</span>
          <span class="opt opt-y">Annuel <span class="save">2 mois offerts</span></span>
        </label>
      </div>

      <div class="grid-plans reveal-stagger">
        {PLANS.map((p) => (
          <div class={`card plan${p.highlight ? " plan-hl" : ""}`}>
            {p.highlight && <span class="plan-badge">Le plus complet</span>}
            <h3 class="plan-name">{p.name}</h3>
            <p class="plan-tag">{p.tagline}</p>
            <p class="plan-price">
              <span class="amount amount-m">{p.monthly} €</span>
              <span class="amount amount-y">{p.yearlyPerMonth} €</span>
              <span class="per">/ mois</span>
            </p>
            <p class="plan-note plan-note-y">Facturé annuellement, vous économisez {p.yearlySave} € par an.</p>
            {p.highlight && <p class="plan-wheel">🎁 Inclut la roue cadeau, 100 % conforme aux règles de Google.</p>}
            <ul class="check-list">
              {p.features.map((f) => <li>{f}</li>)}
            </ul>
            <a class={`btn ${p.highlight ? "btn-primary" : "btn-ghost"} plan-cta`} href={SITE.appUrl}>Essayer gratuitement</a>
          </div>
        ))}
      </div>
      <p class="tarifs-foot">Le paiement se fait en toute sécurité dans l'application, après la création de votre compte.</p>
    </div>
  </section>

  {/* Q&A citable (aligné sur le schema FAQPage) */}
  <section class="faq">
    <div class="container">
      <p class="eyebrow">Questions fréquentes</p>
      <h2>Ce qu'il faut savoir</h2>
      <div class="faq-list reveal-stagger">
        {faq.map((f) => (
          <div class="faq-item">
            <h3>{f.q}</h3>
            <p>{f.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* CTA final */}
  <section class="cta-final">
    <div class="container">
      <h2>Prêt à faire grandir votre réputation, en toute conformité ?</h2>
      <a class="btn btn-primary" href={SITE.appUrl}>Essayer gratuitement</a>
    </div>
  </section>
</Base>

<style>
  .hero { background: linear-gradient(180deg, #fff 0%, var(--cream) 100%); }
  .hero-grid { display: grid; grid-template-columns: 1.1fr .9fr; gap: 3rem; align-items: center; }
  .hero-cta { display: flex; gap: .75rem; flex-wrap: wrap; margin: 1.75rem 0 1rem; }
  .hero-trust { font-size: .9rem; color: var(--text-muted); margin: 0; }
  /* Cluster visuel du hero : téléphone + carte d'avis flottante + roue mini. */
  .hero-visual { position: relative; min-height: 520px; display: flex; align-items: center; justify-content: center; }
  .hero-review { position: absolute; right: -12px; bottom: -18px; width: 244px; transform: rotate(3deg); z-index: 4; }
  .hero-wheel { position: absolute; left: -6px; top: 16px; z-index: 3; }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      /* transform seul : la carte n'est jamais masquée si l'animation échoue. */
      .hero-review { animation: float-up linear both; animation-timeline: view(); animation-range: entry 0% cover 30%; }
    }
  }
  @keyframes float-up { from { transform: translateY(22px) rotate(3deg); } to { transform: rotate(3deg); } }
  @media (max-width: 980px) { .hero-review { width: 214px; right: -6px; } .hero-wheel { display: none; } }
  @media (max-width: 820px) {
    .hero-grid { grid-template-columns: 1fr; }
    /* Empile téléphone puis carte (sinon flex-row = débordement horizontal). */
    .hero-visual { min-height: 0; margin-top: 1.5rem; flex-direction: column; }
    .hero-review { position: static; width: 100%; max-width: 320px; transform: none; margin: 1.25rem auto 0; }
  }

  .proof { background: var(--ink); padding-block: 1.25rem; }
  .proof-line { color: #cdd5e4; text-align: center; margin: 0; font-weight: 600; }

  /* Bande d'avis illustratifs */
  .reviews { background: var(--cream); }
  .reviews-note { color: var(--text-muted); font-size: .9rem; margin: -.25rem 0 0; }
  .reviews-band { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; margin-top: 2rem; align-items: start; }
  @media (max-width: 860px) { .reviews-band { grid-template-columns: 1fr; } }

  .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; margin-top: 2rem; }
  @media (max-width: 860px) { .grid-3 { grid-template-columns: 1fr; } }
  .feature-card { display: flex; flex-direction: column; color: inherit; transition: transform .15s ease, box-shadow .15s ease; }
  .feature-card:hover { text-decoration: none; transform: translateY(-2px); box-shadow: 0 10px 30px rgba(21,35,63,.1); }
  .feature-card h3 { color: var(--ink); }
  .feature-more { margin-top: auto; padding-top: .75rem; color: var(--brass); font-weight: 700; font-size: .9rem; }
  .feature-more::after { content: " \2192"; }

  /* Conformité : chapitre en rupture, fond encre plein, chiffre laiton géant. */
  .conformite { background: var(--ink); color: #cdd5e4; position: relative; overflow: hidden; }
  .conformite::before { content: ""; position: absolute; inset: 0;
    background: radial-gradient(120% 90% at 100% 0%, rgba(176,138,62,.16), transparent 55%); pointer-events: none; }
  .conf-inner { position: relative; max-width: 760px; }
  .conf-eyebrow { text-transform: uppercase; letter-spacing: .12em; font-size: .78rem; font-weight: 700; color: var(--brass); margin: 0 0 .5rem; }
  .conf-giant { font-size: clamp(3rem, 10vw, 6rem); font-weight: 800; line-height: .95; color: #fff; margin: 0 0 .5rem; letter-spacing: -.03em; }
  .conf-giant span { color: var(--brass); }
  .conf-title { color: #fff; font-size: clamp(1.5rem, 3.5vw, 2.25rem); margin: 0 0 1rem; }
  .conf-lead { color: #b9c4d8; font-size: 1.05rem; max-width: 58ch; }
  .conf-list { list-style: none; padding: 0; margin: 1.5rem 0 0; display: grid; gap: .6rem; }
  .conf-list li { position: relative; padding-left: 1.7rem; color: #e6ebf4; }
  .conf-list li::before { content: "✓"; position: absolute; left: 0; color: var(--brass); font-weight: 800; }

  .check-list { list-style: none; padding: 0; margin: 1rem 0 0; }
  .check-list li { position: relative; padding-left: 1.6rem; margin-bottom: .5rem; color: var(--text-secondary); }
  .check-list li::before { content: "✓"; position: absolute; left: 0; color: var(--brass); font-weight: 800; }

  /* Tarifs */
  .tarifs { background: var(--cream); }
  .billing-toggle { display: flex; justify-content: center; margin: 1.5rem 0 2rem; }
  .billing-input { position: absolute; opacity: 0; pointer-events: none; }
  /* Toggle sans knob glissant : l'option active reçoit un fond plein (aucun
     chevauchement possible avec le badge « 2 mois offerts »). */
  .billing-switch { display: inline-flex; flex-wrap: wrap; justify-content: center; gap: 4px;
    background: #fff; border: 1px solid var(--border); border-radius: 999px; padding: 4px; cursor: pointer; user-select: none; }
  .billing-switch .opt { display: inline-flex; align-items: center; gap: .4rem; padding: .5rem 1rem; border-radius: 999px;
    font-weight: 700; font-size: .92rem; color: var(--text-secondary); white-space: nowrap; transition: background .2s ease, color .2s ease; }
  .billing-switch .opt-m { background: var(--ink); color: #fff; }
  .billing-switch .opt-y { background: transparent; }
  .billing-input:checked + .billing-switch .opt-m { background: transparent; color: var(--text-secondary); }
  .billing-input:checked + .billing-switch .opt-y { background: var(--ink); color: #fff; }
  .save { font-size: .7rem; background: var(--brass); color: #fff; padding: .12rem .5rem; border-radius: 999px; flex: none; }

  /* Par défaut (mensuel) : on masque l'annuel. Coché : inverse (CSS :has(),
     zéro JS). Sans JS ni :has(), le défaut mensuel s'affiche correctement. */
  .amount-y, .plan-note-y { display: none; }
  #tarifs:has(.billing-input:checked) .amount-m { display: none; }
  #tarifs:has(.billing-input:checked) .amount-y { display: inline; }
  #tarifs:has(.billing-input:checked) .plan-note-y { display: block; }

  .grid-plans { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.25rem; max-width: 780px; margin-inline: auto; }
  @media (max-width: 720px) { .grid-plans { grid-template-columns: 1fr; } }
  .plan { display: flex; flex-direction: column; }
  .plan-hl { border-color: var(--brass); border-width: 2px; position: relative;
    background: linear-gradient(180deg, #fffdf8, #fff); box-shadow: 0 20px 50px rgba(176,138,62,.18); }
  .plan-hl::before { content: ""; position: absolute; inset: 0; border-radius: inherit; padding: 2px;
    background: linear-gradient(135deg, var(--brass), var(--gold)); -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor; mask-composite: exclude; pointer-events: none; }
  @media (min-width: 721px) { .plan-hl { transform: scale(1.04); } }
  .plan-wheel { margin: .6rem 0 0; font-size: .82rem; color: var(--brass); font-weight: 600; }
  .plan-badge { align-self: flex-start; background: var(--brass); color: #fff; font-size: .74rem; font-weight: 700;
    padding: .2rem .6rem; border-radius: 999px; margin-bottom: .5rem; }
  .plan-name { font-size: 1.4rem; }
  .plan-tag { min-height: 2.8em; }
  .plan-price { margin: .5rem 0 .25rem; }
  .plan-price .amount { font-size: 2.5rem; font-weight: 800; color: var(--ink); }
  .plan-price .per { color: var(--text-muted); font-weight: 600; margin-left: .25rem; }
  .plan-note { font-size: .82rem; color: var(--text-muted); min-height: 1.2em; margin-top: 0; }
  .plan-cta { margin-top: 1.25rem; justify-content: center; }
  .tarifs-foot { text-align: center; color: var(--text-muted); font-size: .9rem; margin-top: 1.5rem; }

  .faq-list { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; margin-top: 2rem; }
  @media (max-width: 760px) { .faq-list { grid-template-columns: 1fr; } }
  .faq-item h3 { margin-bottom: .35rem; }

  .stories { background: #fff; }
  .story-card { display: flex; flex-direction: column; }
  .story-metric { font-size: 2rem; font-weight: 800; color: var(--brass); margin-bottom: .25rem; }
  .story-quote { color: var(--text-secondary); font-style: italic; }
  .story-author { color: var(--text-muted); font-size: .85rem; font-weight: 600; margin: 0; }
  .results { margin-top: 1.5rem; }
  .results-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  @media (max-width: 720px) { .results-stats { grid-template-columns: 1fr; } }
  .stat { background: var(--ink); color: #cdd5e4; border-radius: 16px; padding: 1.5rem 1.6rem; }
  .stat-num { font-size: clamp(2.6rem, 7vw, 3.6rem); font-weight: 800; color: var(--brass); line-height: 1; margin: 0 0 .5rem; letter-spacing: -.02em; }
