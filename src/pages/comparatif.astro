---
import Base from "../layouts/Base.astro";
import Breadcrumb from "../components/Breadcrumb.astro";

// Comparatif GÉNÉRIQUE : on ne cite aucune marque concurrente. Colonne Stela =
// vendeuse et exacte. Colonne « les autres solutions » = pratiques COURANTES du
// marché, formulées de façon générique et défendable (aucune affirmation
// invérifiable sur un acteur précis).
// VIT-10 : tableau à scan visuel. Chaque cellule porte une marque ✓ (vert) ou
// ✗ (rouge) + une phrase courte, pour comprendre d'un coup d'oeil.
const rows = [
  { critere: "Prix affichés en clair", stela: "49 € et 89 € par mois, tout compris", stelaOk: true, autre: "Souvent sur devis", autreOk: false },
  { critere: "Essayer sans rendez-vous commercial", stela: "7 jours gratuits, tout seul", stelaOk: true, autre: "Démonstration souvent obligatoire", autreOk: false },
  { critere: "Prêt en 10 minutes", stela: "Compte créé et prêt tout de suite", stelaOk: true, autre: "Mise en route parfois longue", autreOk: false },
  { critere: "100 % conforme aux règles de Google", stela: "Tous les avis, jamais de tri", stelaOk: true, autre: "Tri des avis parfois proposé, interdit par Google", autreOk: false },
  { critere: "Réponses aux avis écrites pour vous", stela: "Nova les écrit en 10 secondes", stelaOk: true, autre: "À écrire à la main", autreOk: false },
  { critere: "Visible dans ChatGPT et les autres IA", stela: "Inclus dans Constellation", stelaOk: true, autre: "Rarement pris en charge", autreOk: false },
  { critere: "Pour tous les commerces", stela: "Restaurant, coiffeur, garage, santé...", stelaOk: true, autre: "Souvent un seul métier", autreOk: false },
  { critere: "Sans engagement", stela: "On s'arrête quand on veut", stelaOk: true, autre: "Engagement d'un an fréquent", autreOk: false },
];

const faq = [
  { q: "Google interdit-il de filtrer les avis selon la note ?", a: "Oui. Les règles de Google interdisent de solliciter uniquement les clients satisfaits ou de décourager les avis négatifs. Un outil qui trie les avis selon la satisfaction expose votre fiche à une suppression d'avis, voire à une sanction." },
  { q: "Peut-on offrir un cadeau contre un avis ?", a: "Non. Google interdit les avis obtenus contre une récompense, un jeu ou une remise. Stela ne propose aucune mécanique de ce type." },
  { q: "Pourquoi Stela affiche-t-il ses prix ?", a: "Parce que la transparence fait partie de notre positionnement. Vous connaissez le prix (49 € ou 89 € par mois) et vous essayez sans passer par une démonstration obligatoire." },
];
const faqLd = {
  "@context": "https://schema.org", "@type": "FAQPage",
  mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
};
---
<Base
  title="Stela ou les autres solutions du marché ? | Stela"
  description="Comparez Stela aux solutions habituelles de gestion des avis : prix affichés, essai gratuit de 7 jours, conformité Google, réponses par IA et visibilité dans les moteurs IA."
  path="/comparatif"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} is:inline />

  <div class="container"><Breadcrumb items={[{ label: "Comparatif" }]} /></div>

  <section class="hero">
    <div class="container" style="max-width:820px;">
      <p class="eyebrow">Comparatif</p>
      <h1>Stela ou les autres solutions du marché ?</h1>
      <p class="lead">
        Choisir un outil de gestion des avis engage votre fiche Google sur le long terme. Voici une comparaison honnête entre Stela et les pratiques courantes du marché. Notre parti pris : la transparence et la conformité.
      </p>
    </div>
  </section>

  <section>
    <div class="container" style="max-width:900px;">
      <div class="table-wrap">
        <table class="cmp">
          <thead>
            <tr><th>Critère</th><th class="th-stela">Stela</th><th>Les autres solutions</th></tr>
          </thead>
          <tbody>
            {rows.map((r) => (
              <tr>
                <th scope="row">{r.critere}</th>
                <td class="col-stela">
                  <span class={`mark ${r.stelaOk ? "mark-ok" : "mark-no"}`} aria-label={r.stelaOk ? "Oui" : "Non"}>{r.stelaOk ? "✓" : "✗"}</span>
                  <span class="cell-txt">{r.stela}</span>
                </td>
                <td>
                  <span class={`mark ${r.autreOk ? "mark-ok" : "mark-no"}`} aria-label={r.autreOk ? "Oui" : "Non"}>{r.autreOk ? "✓" : "✗"}</span>
                  <span class="cell-txt">{r.autre}</span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="note">La colonne « les autres solutions » décrit des pratiques fréquemment observées sur le marché, sans viser un acteur en particulier.</p>
    </div>
  </section>

  <section class="conformite">
    <div class="container" style="max-width:820px;">
      <h2>Ce que disent les règles de Google</h2>
      <p>
        Acheter des avis ou trier ses clients selon la note, Google l'interdit : votre fiche peut disparaître de la carte, et vous reculez dans Google comme dans les réponses des IA (ChatGPT, Gemini). Les avis obtenus contre une récompense sont eux aussi interdits.
      </p>
      <p>
        Pour en savoir plus, consultez les règles officielles :
        <a href="https://support.google.com/business/answer/2622994" target="_blank" rel="noopener">Règles relatives aux avis (Google Business Profile)</a>.
      </p>
      <p>
        Stela est construit sur ce principe : tous vos clients sont invités à laisser un avis public. Un client déçu vous le dit en privé d'abord, ce qui vous laisse la chance de le rattraper, sans jamais empêcher son avis public.
      </p>
    </div>
  </section>

  <section class="faq">
    <div class="container" style="max-width:820px;">
      <h2>Questions fréquentes</h2>
      <div class="faq-list">
        {faq.map((f) => (
          <div class="faq-item"><h3>{f.q}</h3><p>{f.a}</p></div>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { background: linear-gradient(180deg, #fff 0%, var(--cream) 100%); }
  .table-wrap { overflow-x: auto; }
  .cmp { width: 100%; border-collapse: collapse; background: var(--surface); border: 1px solid var(--border); border-radius: 14px; overflow: hidden; }
  .cmp th, .cmp td { text-align: left; padding: .9rem 1rem; border-bottom: 1px solid var(--border); font-size: .92rem; vertical-align: top; }
  .cmp thead th { background: var(--ink); color: #fff; font-size: .9rem; }
  .cmp thead .th-stela { background: #0f1a30; }
  .cmp tbody th { font-weight: 700; color: var(--ink); width: 34%; }
  .cmp td { color: var(--text-secondary); }
  /* Colonne Stela surlignée (crème) pour tirer l'oeil vers le bon choix. */
  .cmp .col-stela { background: #fbf7ef; color: var(--ink); font-weight: 600; }
  /* Marque ✓/✗ : gros, coloré, alignée en haut de la cellule pour un scan rapide. */
  .mark { display: inline-flex; align-items: center; justify-content: center; width: 1.4rem; height: 1.4rem;
    border-radius: 50%; font-weight: 900; font-size: .85rem; margin-right: .5rem; flex: none; vertical-align: -.35rem; }
  .mark-ok { background: rgba(30,158,99,.14); color: #1E9E63; }
  .mark-no { background: rgba(192,57,43,.12); color: #C0392B; }
  .cell-txt { display: inline; }
  .note { font-size: .82rem; color: var(--text-muted); margin-top: 1rem; }
  .conformite { background: #fff; }
  .faq-list { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; margin-top: 1.5rem; }
  @media (max-width: 760px) { .faq-list { grid-template-columns: 1fr; } }
  .faq-item h3 { margin-bottom: .35rem; }
</style>
