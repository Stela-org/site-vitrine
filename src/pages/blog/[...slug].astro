---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { SITE } from "../../config/site";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const url = new URL(`/blog/${post.id}`, SITE.url).href;
const d = post.data;

const articleLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: d.title,
  description: d.description,
  inLanguage: "fr-FR",
  datePublished: d.pubDate.toISOString(),
  dateModified: (d.updatedDate ?? d.pubDate).toISOString(),
  author: { "@type": "Organization", name: SITE.brand },
  publisher: { "@type": "Organization", name: SITE.brand },
  mainEntityOfPage: url,
};
const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Accueil", item: SITE.url },
    { "@type": "ListItem", position: 2, name: "Blog", item: new URL("/blog", SITE.url).href },
    { "@type": "ListItem", position: 3, name: d.title, item: url },
  ],
};

const dateStr = (d.updatedDate ?? d.pubDate).toLocaleDateString("fr-FR", { year: "numeric", month: "long", day: "numeric" });

// Maillage : autres articles.
const others = (await getCollection("blog")).filter((p) => p.id !== post.id).slice(0, 3);
---
<Base title={`${d.title} | Blog Stela`} description={d.description} path={`/blog/${post.id}`}>
  <script type="application/ld+json" set:html={JSON.stringify(articleLd)} is:inline />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} is:inline />

  <article class="post">
    <div class="container">
      <nav class="crumbs" aria-label="Fil d'Ariane"><a href="/">Accueil</a> <span>/</span> <a href="/blog">Blog</a></nav>
      <p class="eyebrow">{d.keyword}</p>
      <h1>{d.title}</h1>
      <p class="post-date">Mis à jour le {dateStr}</p>
      <div class="post-body">
        <Content />
      </div>

      <div class="post-cta card">
        <h2>Collectez plus d'avis, en toute conformité</h2>
        <p>Stela aide les commerces locaux à collecter, répondre et fidéliser, sans jamais filtrer une note.</p>
        <a class="btn btn-primary" href={SITE.appUrl}>Essayer gratuitement</a>
      </div>

      {others.length > 0 && (
        <div class="post-others">
          <h2>À lire aussi</h2>
          <ul>{others.map((o) => <li><a href={`/blog/${o.id}`}>{o.data.title}</a></li>)}</ul>
        </div>
      )}
    </div>
  </article>
</Base>

<style>
  .post .container { max-width: 760px; }
  .crumbs { font-size: .85rem; color: var(--text-muted); margin-bottom: .75rem; }
  .crumbs a { color: var(--text-muted); } .crumbs span { margin: 0 .35rem; }
  .post-date { color: var(--text-muted); font-size: .85rem; margin-top: -.3rem; }
  .post-body { margin-top: 1.5rem; }
  .post-body :global(h2) { font-size: 1.4rem; margin: 2rem 0 .6rem; }
  .post-body :global(h3) { font-size: 1.1rem; margin: 1.4rem 0 .4rem; }
  .post-body :global(p), .post-body :global(li) { color: var(--text-secondary); line-height: 1.8; }
  .post-body :global(ul), .post-body :global(ol) { padding-left: 1.4rem; margin-bottom: 1rem; }
  .post-body :global(strong) { color: var(--ink); }
  .post-cta { margin: 2.5rem 0; text-align: center; }
  .post-cta h2 { font-size: 1.3rem; }
  .post-others ul { list-style: none; padding: 0; }
  .post-others li { padding: .5rem 0; border-top: 1px solid var(--border); }
  .post-others a { font-weight: 600; }
</style>
