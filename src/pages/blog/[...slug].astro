---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { SITE , TARIFS_URL } from "../../config/site";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const url = new URL(`/blog/${post.id}`, SITE.url).href;
const d = post.data;

// VIT-16 ② : Google exige la propriété `image` sur un Article pour accorder le
// rich result. On prend l'image OG déclarée dans le frontmatter de l'article,
// et à défaut l'image OG par défaut du site. URL absolue, comme demandé.
const articleImage = new URL(d.ogImage ?? "/images/og-default.png", SITE.url).href;
const articleLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: d.title,
  description: d.description,
  image: [articleImage],
  inLanguage: "fr-FR",
  datePublished: d.pubDate.toISOString(),
  dateModified: (d.updatedDate ?? d.pubDate).toISOString(),
  author: {
    "@type": "Person",
    name: "Corentin Janin",
    jobTitle: "Cofondateur de Stela",
    url: new URL("/notre-histoire", SITE.url).href,
    sameAs: SITE.sameAs,
  },
  publisher: { "@type": "Organization", name: SITE.brand, logo: { "@type": "ImageObject", url: new URL("/images/logo-stela.svg", SITE.url).href } },
  mainEntityOfPage: url,
};
const dateStr = (d.updatedDate ?? d.pubDate).toLocaleDateString("fr-FR", { year: "numeric", month: "long", day: "numeric" });

// Maillage : autres articles.
const others = (await getCollection("blog")).filter((p) => p.id !== post.id).slice(0, 3);
---
<Base title={`${d.metaTitle ?? d.title} | Blog Stela`} description={d.description} path={`/blog/${post.id}`} ogImage={d.ogImage ?? "/images/og-default.png"}>
  <script type="application/ld+json" set:html={JSON.stringify(articleLd)} is:inline />

  <article class="post">
    <div class="container">
      <Breadcrumb items={[{ label: "Blog", href: "/blog" }, { label: d.title }]} />
      <p class="eyebrow">{d.keyword}</p>
      <h1>{d.title}</h1>
      <div class="post-meta">
        <img class="post-author-img" src="/images/equipe-corentin.png" alt="Corentin Janin" width="40" height="40" loading="lazy" decoding="async" />
        <span>Par <a href="/notre-histoire">Corentin Janin</a>, cofondateur de Stela · Mis à jour le {dateStr}</span>
      </div>
      <div class="post-body">
        <Content />
      </div>

      <aside class="author-bio card">
        <img src="/images/equipe-corentin.png" alt="Portrait de Corentin Janin" width="64" height="64" loading="lazy" decoding="async" />
        <div>
          <p class="author-name">Corentin Janin, cofondateur de Stela</p>
          <p class="author-desc">Après avoir équipé plus de 170 restaurants avec la génération précédente de l'outil, Corentin défend une collecte d'avis 100 % conforme aux règles de Google. <a href="/notre-histoire">Notre histoire</a>.</p>
        </div>
      </aside>

      <div class="post-cta card">
        <h2>Collectez plus d'avis, en toute conformité</h2>
        <p>Stela aide les commerces locaux à collecter, répondre et fidéliser, sans jamais filtrer une note.</p>
        <a class="btn btn-primary" href={TARIFS_URL}>Essai gratuit 7 jours</a>
      </div>

      {others.length > 0 && (
        <div class="post-others">
          <h2>À lire aussi</h2>
          <ul>{others.map((o) => <li><a href={`/blog/${o.id}`}>{o.data.title}</a></li>)}</ul>
        </div>
      )}
    </div>
  </article>
</Base>

<style>
  .post .container { max-width: 760px; }
  .crumbs { font-size: .85rem; color: var(--text-muted); margin-bottom: .75rem; }
  .crumbs a { color: var(--text-muted); } .crumbs span { margin: 0 .35rem; }
  .post-date { color: var(--text-muted); font-size: .85rem; margin-top: -.3rem; }
  .post-meta { display: flex; align-items: center; gap: .6rem; color: var(--text-muted); font-size: .85rem; margin-top: -.2rem; }
  .post-meta a { font-weight: 600; }
  .post-author-img { width: 40px; height: 40px; border-radius: 50%; object-fit: cover; flex: none; }
  .author-bio { display: flex; gap: 1rem; align-items: center; margin: 2rem 0; }
  .author-bio img { width: 64px; height: 64px; border-radius: 50%; object-fit: cover; flex: none; }
  .author-name { font-weight: 700; color: var(--ink); margin: 0 0 .25rem; }
  .author-desc { color: var(--text-secondary); font-size: .9rem; margin: 0; }
  .post-body { margin-top: 1.5rem; }
  .post-body :global(h2) { font-size: 1.4rem; margin: 2rem 0 .6rem; }
  .post-body :global(h3) { font-size: 1.1rem; margin: 1.4rem 0 .4rem; }
  .post-body :global(p), .post-body :global(li) { color: var(--text-secondary); line-height: 1.8; }
  .post-body :global(ul), .post-body :global(ol) { padding-left: 1.4rem; margin-bottom: 1rem; }
  .post-body :global(strong) { color: var(--ink); }
  .post-cta { margin: 2.5rem 0; text-align: center; }
  .post-cta h2 { font-size: 1.3rem; }
  .post-others ul { list-style: none; padding: 0; }
  .post-others li { padding: .5rem 0; border-top: 1px solid var(--border); }
  .post-others a { font-weight: 600; }
</style>
