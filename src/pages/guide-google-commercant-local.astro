---
import Base from "../layouts/Base.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import { SITE } from "../config/site";

const chapters = [
  "Créer et optimiser sa fiche Google Business Profile, étape par étape",
  "Collecter des avis en continu, sans jamais enfreindre les règles de Google",
  "Répondre aux avis, positifs comme négatifs, avec des modèles prêts à l'emploi",
  "Être visible dans les réponses de ChatGPT, Gemini et Perplexity (GEO)",
  "Les erreurs qui font suspendre une fiche, et comment les éviter",
];
---
<Base
  title="Le guide Google du commerçant local (PDF gratuit) | Stela"
  description="Recevez gratuitement notre guide pour maîtriser votre fiche Google, collecter des avis en toute conformité et être visible dans les moteurs IA. PDF par email."
  path="/guide-google-commercant-local"
>
  <div class="container"><Breadcrumb items={[{ label: "Guide gratuit" }]} /></div>
  <section class="hero">
    <div class="container guide-grid">
      <div>
        <p class="eyebrow">Guide gratuit · PDF</p>
        <h1>Le guide Google du commerçant local</h1>
        <p class="lead">Tout ce qu'un commerce local doit savoir pour tirer le meilleur de Google, en toute conformité. Concret, sans jargon, à appliquer dès aujourd'hui.</p>
        <ul class="check-list">
          {chapters.map((c) => <li>{c}</li>)}
        </ul>
      </div>

      <div class="guide-form-card card">
        <h2>Recevez-le par email</h2>
        <p class="gf-sub">Votre prénom, votre email, et le guide arrive dans votre boîte.</p>
        <form method="POST" action="/api/lead-subscribe" class="lead-form">
          {/* Honeypot anti-bot : invisible, doit rester vide. */}
          <div class="hp" aria-hidden="true">
            <label>Ne pas remplir<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
          </div>
          <label class="lead-field">Votre prénom
            <input type="text" name="first_name" required placeholder="Camille" autocomplete="given-name" maxlength="40" />
          </label>
          <label class="lead-field">Votre email professionnel
            <input type="email" name="email" required placeholder="vous@etablissement.fr" autocomplete="email" />
          </label>
          <label class="lead-consent">
            <input type="checkbox" name="consent" value="1" required />
            <span>Je souhaite recevoir le guide et les conseils Stela par email (désinscription en un clic).</span>
          </label>
          <button type="submit" class="btn btn-primary">Recevoir le guide gratuit</button>
          <p class="lead-rgpd">Sans cette case, pas d'envoi. Vos données ne sont ni revendues, ni cédées. Voir la <a href="/politique-confidentialite">politique de confidentialité</a>.</p>
        </form>
      </div>
    </div>
  </section>
</Base>

<script>
  // LOT GADS-2, suivi avancé de la conversion `guide_telecharge`. La conversion
  // se mesure sur la page de merci, APRÈS la redirection de /api/lead-subscribe :
  // c'est donc ici, sur la page du formulaire, qu'il faut préparer l'empreinte.
  //
  // On hache À LA SAISIE, pas au submit : le submit natif quitte la page, or
  // crypto.subtle est asynchrone, une empreinte lancée au submit n'aurait aucune
  // garantie d'être écrite avant la navigation. À la saisie, elle est prête bien
  // avant le clic.
  //
  // Ce qui est mis de côté est l'EMPREINTE, dans sessionStorage. Ni l'email en
  // clair, ni l'URL (qui fuirait par le Referer et les journaux serveur).
  import { hashEmail, stashEmailHash } from "../lib/track";
  const form = document.querySelector<HTMLFormElement>(".lead-form");
  const email = form?.querySelector<HTMLInputElement>('input[name="email"]');
  if (email) {
    let derniere = "";
    const preparer = () => {
      const saisie = email.value;
      if (saisie === derniere) return;
      derniere = saisie;
      // Email incomplet : hashEmail rend null, rien n'est mis de côté. La
      // conversion partira alors sans empreinte, jamais avec une valeur inventée.
      hashEmail(saisie).then(stashEmailHash);
    };
    email.addEventListener("input", preparer);
    email.addEventListener("change", preparer);
  }
</script>

<style>
  .hero { background: linear-gradient(180deg, #fff 0%, var(--cream) 100%); }
  .guide-grid { display: grid; grid-template-columns: 1.05fr .95fr; gap: 3rem; align-items: center; }
  @media (max-width: 860px) { .guide-grid { grid-template-columns: 1fr; } }
  .check-list { list-style: none; padding: 0; margin: 1.5rem 0 0; }
  .check-list li { position: relative; padding-left: 1.7rem; margin-bottom: .6rem; color: var(--text-secondary); }
  .check-list li::before { content: "✓"; position: absolute; left: 0; color: var(--brass); font-weight: 800; }
  .guide-form-card { max-width: 440px; }
  .gf-sub { color: var(--text-secondary); font-size: .95rem; }
  .lead-form { display: grid; gap: 1rem; margin-top: 1rem; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .lead-field { display: flex; flex-direction: column; gap: .35rem; font-weight: 700; font-size: .9rem; color: var(--ink); }
  .lead-field input { padding: .7rem .8rem; border: 1px solid var(--border); border-radius: 10px; font: inherit; }
  .lead-consent { display: flex; gap: .6rem; align-items: flex-start; font-size: .82rem; color: var(--text-secondary); }
  .lead-consent input { margin-top: .2rem; flex: none; }
  .lead-form .btn { justify-content: center; }
  .lead-rgpd { font-size: .76rem; color: var(--text-muted); margin: 0; }
</style>
