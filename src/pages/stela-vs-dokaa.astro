---
import Base from "../layouts/Base.astro";
import { SITE , signupUrl } from "../config/site";

// Comparaison factuelle. Principe : n'affirmer que des faits vérifiables, sourcer
// les règles de Google, ton professionnel, aucun dénigrement. Les points non
// vérifiables publiquement sont formulés comme « à vérifier auprès de l'éditeur ».
const rows = [
  { critere: "Prix affichés publiquement", stela: "Oui, 49 € et 89 € par mois", autre: "Non, démonstration requise pour connaître les prix" },
  { critere: "Essai en autonomie (self-serve)", stela: "Oui, sans carte bancaire", autre: "Parcours via démonstration commerciale" },
  { critere: "Engagement", stela: "Sans engagement, résiliable à tout moment", autre: "À vérifier auprès de l'éditeur" },
  { critere: "Secteurs couverts", stela: "Tous les commerces locaux", autre: "Orientation restauration" },
  { critere: "Filtrage des avis selon la note", stela: "Jamais (interdit par Google)", autre: "À vérifier auprès de l'éditeur" },
  { critere: "Incitation à laisser un avis (jeu, récompense)", stela: "Aucune (interdit par Google)", autre: "À vérifier auprès de l'éditeur" },
  { critere: "Contenu du site lisible sans JavaScript", stela: "Oui", autre: "À vérifier" },
  { critere: "Contenu dédié à la visibilité IA (GEO)", stela: "Oui", autre: "À vérifier" },
];

const faq = [
  { q: "Google interdit-il de filtrer les avis selon la note ?", a: "Oui. Les règles de Google interdisent de solliciter uniquement les clients satisfaits ou de décourager les avis négatifs. Un outil qui trie les avis selon la satisfaction expose votre fiche à une suppression d'avis ou à une sanction." },
  { q: "Peut-on offrir un cadeau contre un avis ?", a: "Non. Google interdit les avis incités par une récompense, un jeu ou une remise. Stela ne propose aucune mécanique de ce type." },
  { q: "Pourquoi Stela affiche-t-il ses prix ?", a: "Parce que la transparence fait partie de notre positionnement. Vous connaissez le prix (49 € ou 89 € par mois) et vous essayez sans passer par une démonstration obligatoire." },
];
const faqLd = {
  "@context": "https://schema.org", "@type": "FAQPage",
  mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
};
const breadcrumbLd = {
  "@context": "https://schema.org", "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Accueil", item: SITE.url },
    { "@type": "ListItem", position: 2, name: "Stela vs Dokaa", item: new URL("/stela-vs-dokaa", SITE.url).href },
  ],
};
---
<Base
  title="Stela vs Dokaa : comparaison transparente | Stela"
  description="Comparaison factuelle entre Stela et Dokaa : prix affichés, essai gratuit, conformité aux règles de Google et couverture multi-secteurs."
  path="/stela-vs-dokaa"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} is:inline />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} is:inline />

  <section class="hero">
    <div class="container" style="max-width:820px;">
      <p class="eyebrow">Comparatif</p>
      <h1>Stela et Dokaa : une comparaison transparente</h1>
      <p class="lead">
        Choisir un outil de gestion des avis engage votre fiche Google sur le long terme. Voici une comparaison factuelle, fondée sur des informations publiques et sur les règles officielles de Google. Notre parti pris : la transparence et la conformité.
      </p>
    </div>
  </section>

  <section>
    <div class="container" style="max-width:900px;">
      <div class="table-wrap">
        <table class="cmp">
          <thead>
            <tr><th>Critère</th><th>Stela</th><th>Dokaa</th></tr>
          </thead>
          <tbody>
            {rows.map((r) => (
              <tr>
                <th scope="row">{r.critere}</th>
                <td class="ok">{r.stela}</td>
                <td>{r.autre}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="note">Les éléments notés « à vérifier auprès de l'éditeur » ne sont pas affirmés faute d'information publique et vérifiable. Nous vous invitons à les confirmer directement.</p>
    </div>
  </section>

  <section class="conformite">
    <div class="container" style="max-width:820px;">
      <h2>Ce que disent les règles de Google</h2>
      <p>
        Google interdit deux pratiques courantes dans la collecte d'avis : le filtrage des avis selon la satisfaction du client, et les avis obtenus contre une récompense. Ces pratiques peuvent entraîner la suppression d'avis, voire une sanction de la fiche.
      </p>
      <p>
        Pour en savoir plus, consultez les règles officielles de Google sur les avis :
        <a href="https://support.google.com/business/answer/2622994" rel="noopener">Règles relatives aux avis (Google Business Profile)</a>.
      </p>
      <p>
        Stela est construit sur ce principe : tous vos clients sont invités à laisser un avis public, sans filtre et sans récompense. La récupération d'un client insatisfait se fait en plus d'un avis public, jamais à sa place.
      </p>
    </div>
  </section>

  <section class="faq">
    <div class="container" style="max-width:820px;">
      <h2>Questions fréquentes</h2>
      <div class="faq-list">
        {faq.map((f) => (
          <div class="faq-item"><h3>{f.q}</h3><p>{f.a}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-final">
    <div class="container">
      <h2>Essayez Stela, prix affichés et essai gratuit</h2>
      <a class="btn btn-primary" href={signupUrl({ campaign: "comparatif" })}>Essayer gratuitement</a>
    </div>
  </section>
</Base>

<style>
  .hero { background: linear-gradient(180deg, #fff 0%, var(--cream) 100%); }
  .table-wrap { overflow-x: auto; }
  .cmp { width: 100%; border-collapse: collapse; background: var(--surface); border: 1px solid var(--border); border-radius: 14px; overflow: hidden; }
  .cmp th, .cmp td { text-align: left; padding: .9rem 1rem; border-bottom: 1px solid var(--border); font-size: .92rem; vertical-align: top; }
  .cmp thead th { background: var(--ink); color: #fff; font-size: .9rem; }
  .cmp tbody th { font-weight: 700; color: var(--ink); width: 34%; }
  .cmp td { color: var(--text-secondary); }
  .cmp td.ok { color: var(--ink); font-weight: 600; }
  .note { font-size: .82rem; color: var(--text-muted); margin-top: 1rem; }
  .conformite { background: #fff; }
  .faq-list { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; margin-top: 1.5rem; }
  @media (max-width: 760px) { .faq-list { grid-template-columns: 1fr; } }
  .faq-item h3 { margin-bottom: .35rem; }
  .cta-final { background: var(--ink); text-align: center; }
  .cta-final h2 { color: #fff; margin-bottom: 1.5rem; }
</style>
