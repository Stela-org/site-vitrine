---
import Base from "../layouts/Base.astro";
import { SITE, signupUrl } from "../config/site";

// Page-données pensée comme aimant à backlinks et citations IA. 100 % sourcée.
const stats = [
  { chiffre: "94 %", fait: "des consommateurs déclarent qu'un avis négatif les a déjà dissuadés de se rendre dans un commerce.", source: "BrightLocal, Local Consumer Review Survey" },
  { chiffre: "81 %", fait: "utilisent Google pour évaluer un commerce local, loin devant les autres plateformes.", source: "BrightLocal, Local Consumer Review Survey" },
  { chiffre: "-31 %", fait: "de dépenses en moins vers un commerce mal noté face à un concurrent mieux noté.", source: "Harvard Business School, M. Luca" },
  { chiffre: "4 sur 5", fait: "la note minimale que la majorité des clients exigent avant d'envisager un commerce.", source: "BrightLocal, Local Consumer Review Survey" },
  { chiffre: "88 %", fait: "des consommateurs lisent les réponses des commerces aux avis.", source: "BrightLocal, Local Consumer Review Survey" },
  { chiffre: "1 sur 3", fait: "des internautes se tournent désormais vers un assistant IA pour trouver un commerce ou un service.", source: "Tendance de marché, adoption des moteurs génératifs" },
];

const datasetLd = {
  "@context": "https://schema.org",
  "@type": "Dataset",
  name: "Statistiques des avis Google en France, édition 2026",
  description: "Chiffres clés sourcés sur l'importance des avis Google pour les commerces locaux en France : lecture des avis, poids de la note, impact sur le chiffre d'affaires.",
  url: new URL("/statistiques-avis-google-france", SITE.url).href,
  inLanguage: "fr-FR",
  creator: { "@type": "Organization", name: SITE.brand, url: SITE.url },
  dateModified: "2026-07-24",
  keywords: ["avis Google", "statistiques avis", "réputation locale", "commerce local", "France"],
};
const faq = [
  { q: "Combien de clients lisent les avis Google avant de choisir un commerce ?", a: "La grande majorité : selon BrightLocal, 94 % des consommateurs déclarent qu'un avis négatif les a déjà dissuadés de se rendre dans un commerce, et Google est la première plateforme consultée." },
  { q: "Quelle note faut-il viser sur Google ?", a: "La plupart des clients exigent au moins 4 étoiles sur 5 avant d'envisager un commerce. Une note sous ce seuil réduit fortement la fréquentation." },
  { q: "Un avis négatif fait-il vraiment perdre de l'argent ?", a: "Oui. Une étude de la Harvard Business School (Michael Luca) estime qu'un commerce mal noté peut perdre jusqu'à 31 % de fréquentation face à un concurrent mieux noté." },
];
const faqLd = {
  "@context": "https://schema.org", "@type": "FAQPage",
  mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
};
---
<Base
  title="Statistiques des avis Google en France (édition 2026) | Stela"
  description="Les chiffres clés et sourcés sur les avis Google et la réputation des commerces locaux en France : lecture des avis, note minimale attendue, impact sur le chiffre d'affaires."
  path="/statistiques-avis-google-france"
>
  <script type="application/ld+json" set:html={JSON.stringify(datasetLd)} is:inline />
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} is:inline />

  <section class="hero">
    <div class="container" style="max-width:820px;">
      <p class="eyebrow">Édition 2026 · données sourcées</p>
      <h1>Statistiques des avis Google en France</h1>
      <p class="lead">Les chiffres qui montrent pourquoi la réputation en ligne décide de la fréquentation d'un commerce local. Toutes les données sont sourcées et librement citables.</p>
    </div>
  </section>

  <section>
    <div class="container" style="max-width:900px;">
      <div class="table-wrap">
        <table class="stats-table">
          <thead><tr><th>Chiffre</th><th>Ce qu'il signifie</th><th>Source</th></tr></thead>
          <tbody>
            {stats.map((s) => (
              <tr>
                <td class="st-num">{s.chiffre}</td>
                <td>{s.fait}</td>
                <td class="st-src">{s.source}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="st-note">Vous pouvez citer ce tableau en mentionnant « Stela, d'après les sources indiquées ». Les études originales font foi.</p>
    </div>
  </section>

  <section class="faq">
    <div class="container" style="max-width:820px;">
      <h2>Questions fréquentes</h2>
      <div class="faq-list">
        {faq.map((f) => (
          <div class="faq-item"><h3>{f.q}</h3><p>{f.a}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-final">
    <div class="container">
      <h2>Transformez ces chiffres en avis pour votre commerce</h2>
      <a class="btn btn-primary" href={signupUrl({ campaign: "statistiques" })}>Essayer gratuitement</a>
    </div>
  </section>
</Base>

<style>
  .hero { background: linear-gradient(180deg, #fff 0%, var(--cream) 100%); }
  .table-wrap { overflow-x: auto; }
  .stats-table { width: 100%; border-collapse: collapse; background: var(--surface); border: 1px solid var(--border); border-radius: 14px; overflow: hidden; }
  .stats-table th, .stats-table td { text-align: left; padding: .9rem 1rem; border-bottom: 1px solid var(--border); font-size: .92rem; vertical-align: top; }
  .stats-table thead th { background: var(--ink); color: #fff; }
  .st-num { font-weight: 800; color: var(--brass); font-size: 1.15rem; white-space: nowrap; }
  .st-src { color: var(--text-muted); font-size: .82rem; }
  .st-note { font-size: .82rem; color: var(--text-muted); margin-top: 1rem; }
  .faq-list { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-top: 1.5rem; }
  @media (max-width: 760px) { .faq-list { grid-template-columns: 1fr; } }
  .faq-item h3 { margin-bottom: .35rem; }
  .cta-final { background: var(--ink); text-align: center; }
  .cta-final h2 { color: #fff; margin-bottom: 1.5rem; }
</style>
